#!/usr/bin/env python3
"""Start one interactive Codex worker in a new Herdr pane and record its identity."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import uuid

from launch_records import validate_launches
from record_io import append_record, locked, read_records, token, utc_now


def output(argv, cwd=None):
    return subprocess.check_output(argv, cwd=cwd, text=True).strip()


def herdr_error_code(stderr):
    try:
        body = json.loads(stderr)
    except json.JSONDecodeError:
        return None
    if isinstance(body, dict) and isinstance(body.get("error"), dict):
        code = body["error"].get("code")
        return code if isinstance(code, str) and code else None
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--cwd", type=Path, required=True)
    parser.add_argument("--agent", required=True)
    for name in ("project", "task", "attempt", "session"):
        parser.add_argument("--" + name, required=True, type=token)
    parser.add_argument("--model", default="gpt-6.1-sol")
    parser.add_argument("--effort", choices=("low", "medium", "high", "xhigh"), default="xhigh")
    parser.add_argument("--direction", choices=("right", "down"), default="down")
    parser.add_argument("--codex-home", type=Path)
    # 2026-10-11 user decision: Codex sessions run at the normal tier until told otherwise.
    parser.add_argument("--service-tier", choices=("default", "fast"), default="default")
    # Switching an existing worker's executor keeps its context by resuming its native session.
    parser.add_argument("--resume", metavar="NATIVE_SESSION")
    args = parser.parse_args()
    if os.environ.get("HERDR_ENV") != "1":
        raise ValueError("只能从 Herdr 管理的 pane 启动")
    if re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", args.agent) is None:
        raise ValueError("agent 名不符合 Herdr 格式")
    if not args.model or "\n" in args.model:
        raise ValueError("模型不能为空或包含换行")
    if os.environ.get("GIT_CONFIG_COUNT", "0") != "0":
        raise ValueError("调用环境已有进程级 Git 配置；不能覆盖，请从普通主控 shell 启动")
    root, cwd = args.root.resolve(), args.cwd.resolve()
    hooks = Path(__file__).resolve().parent / "git-hooks"
    role_card = root / ".project-map/roles/worker.md"
    role_card.read_bytes().decode("utf-8")
    launch_id = "launch-" + uuid.uuid4().hex
    if args.resume is not None and re.fullmatch(r"[0-9a-f-]{36}", args.resume) is None:
        raise ValueError("--resume 需要原生会话 UUID")
    # --no-daemon: a shared background server kept each worker's session writer lock after its
    # pane closed (2026-10-13), blocking an executor switch; the product Panes launch uses it too.
    argv = ["codex", *(["resume", args.resume] if args.resume else []), "--no-daemon",
            "-m", args.model, "-c", "model_reasoning_effort=" + json.dumps(args.effort),
            # Always explicit: the user's global config sets priority, which an omitted flag inherits.
            # evidence/2026-10-13-tier-probe/probe-01.json: "default" is what the session reports back.
            "-c", 'service_tier="fast"' if args.service_tier == "fast" else 'service_tier="default"',
            "-c", "check_for_update_on_startup=false",
            "--sandbox", "workspace-write", "--ask-for-approval", "on-request"]
    logfile = root / "records/launches.jsonl"
    lockfile = root / "records/.launches.lock"
    row = dict(schema=1, phase="prepared", launch_id=launch_id, created_at=utc_now(),
               project=args.project, task=args.task, attempt=args.attempt, session=args.session,
               role="worker", cli="codex", cli_version=output(["codex", "--version"]),
               model=args.model, effort=args.effort, service_tier_requested=args.service_tier, argv=argv,
               resumes_native_session=args.resume,
               cwd=str(cwd), project_commit=output(["git", "rev-parse", "HEAD"], cwd),
               launcher_commit=output(["git", "rev-parse", "HEAD"], Path(__file__).resolve().parents[1]),
               role_card=str(role_card), role_card_version=output(["git", "log", "-1", "--format=%H", "--",
                                                                ".project-map/roles/worker.md"], root),
               native_session="unknown")
    with locked(lockfile):
        validate_launches([*read_records(logfile), row])
        append_record(logfile, row)
    pane = None
    start_argv = None
    last_call = None
    stage = "split"

    def invoke(command, *, timeout=None):
        nonlocal last_call
        last_call = dict(argv=command, returncode=None, stdout="", stderr="")
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired as exc:
            # TimeoutExpired 的部分输出可能为 bytes；repr 保留原字节转义。
            last_call.update(stdout=exc.stdout if isinstance(exc.stdout, str) else repr(exc.stdout or b""),
                             stderr=exc.stderr if isinstance(exc.stderr, str) else repr(exc.stderr or b""))
            raise
        last_call.update(returncode=result.returncode, stdout=result.stdout, stderr=result.stderr)
        if result.returncode:
            print(result.stdout, end="")
            print(result.stderr, end="", file=sys.stderr)
            raise subprocess.CalledProcessError(result.returncode, command,
                                                output=result.stdout, stderr=result.stderr)
        return json.loads(result.stdout)

    try:
        env = {"A2A_PROJECT": args.project, "A2A_TASK": args.task, "A2A_ATTEMPT": args.attempt,
               "A2A_SESSION": args.session, "A2A_ROLE": "worker", "A2A_LAUNCH": launch_id,
               "A2A_LAUNCHES": str(logfile), "GIT_CONFIG_COUNT": "1",
               "GIT_CONFIG_KEY_0": "core.hooksPath", "GIT_CONFIG_VALUE_0": str(hooks)}
        if args.codex_home is not None:
            env["CODEX_HOME"] = str(args.codex_home.resolve(strict=True))
        split_argv = ["herdr", "pane", "split", "--current", "--direction", args.direction,
                      "--cwd", str(cwd), "--no-focus"]
        for key, value in env.items():
            split_argv.extend(["--env", key + "=" + value])
        response = invoke(split_argv)
        pane = response["result"]["pane"]["pane_id"]
        stage = "shell"
        # Herdr 0.9.3 available_pane_shell_from_job: shell owns the foreground
        # group, and no other foreground process remains (including rc helpers).
        deadline = time.monotonic() + 30
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("等待 shell 可用超过 30 秒；不启动 agent")
            info = invoke(["herdr", "pane", "process-info", "--pane", pane],
                          timeout=remaining)["result"]["process_info"]
            if info["pane_id"] != pane:
                raise ValueError("shell 状态返回的 pane 身份不符")
            shell_pid = info.get("shell_pid")
            processes = info.get("foreground_processes", [])
            if (shell_pid is not None and shell_pid > 0
                    and info.get("foreground_process_group_id") == shell_pid
                    and len(processes) == 1 and processes[0]["pid"] == shell_pid
                    and processes[0]["name"].rsplit("/", 1)[-1].lstrip("-").removesuffix(".exe").lower()
                    in {"sh", "bash", "dash", "zsh", "fish", "ksh", "mksh", "csh", "tcsh",
                        "elvish", "xonsh", "nu", "pwsh", "powershell", "cmd"}):
                break
            time.sleep(min(0.1, max(0, deadline - time.monotonic())))
        start_argv = ["herdr", "agent", "start", args.agent, "--kind", "codex", "--pane", pane,
                      "--", *argv[1:]]
        stage = "agent_start"
        started = invoke(start_argv)
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
        call = last_call or dict(argv=[], returncode=None, stdout="", stderr="")
        error_code = ("command_failed" if isinstance(exc, subprocess.CalledProcessError)
                      else "timeout" if isinstance(exc, (TimeoutError, subprocess.TimeoutExpired))
                      else "invalid_response" if isinstance(exc, (ValueError, KeyError)) else "os_error")
        error_code = herdr_error_code(call["stderr"]) or error_code
        failure = dict(row, phase="failed", pane=pane, agent=args.agent, error=str(exc),
                       error_code=error_code, failure_stage=stage, herdr_start_argv=start_argv,
                       herdr_command=call["argv"], herdr_returncode=call["returncode"],
                       herdr_stdout=call["stdout"], herdr_stderr=call["stderr"],
                       outcome="unknown" if stage == "agent_start" else "not_started",
                       observations=[], pane_disposition="retained_for_controller" if pane else "not_created",
                       observed_at=utc_now())
        if pane is not None and stage == "agent_start":
            # 失败后只观察本次 split 的 pane；绝不按名称操作其他会话。
            observed = {}
            registration_absent = False
            for key, command in (
                ("process_info", ["herdr", "pane", "process-info", "--pane", pane]),
                ("agent", ["herdr", "agent", "get", pane]),
            ):
                try:
                    value = invoke(command, timeout=5)["result"][key]
                    if value["pane_id"] != pane:
                        raise ValueError("失败诊断返回的 pane 身份不符")
                    observed[key] = value
                    if key == "agent":
                        registration_absent = value.get("name") is None
                    failure["observations"].append(dict(last_call, value=value))
                except (OSError, ValueError, KeyError, subprocess.CalledProcessError,
                        subprocess.TimeoutExpired) as diagnostic_error:
                    failure["observations"].append(dict(last_call, error=str(diagnostic_error)))
                    if key == "agent" and herdr_error_code(last_call["stderr"]) == "agent_not_found":
                        registration_absent = True
            info = observed.get("process_info", {})
            agent = observed.get("agent", {})
            processes = info.get("foreground_processes", [])
            codex_running = any(p.get("name", "").rsplit("/", 1)[-1] == "codex"
                                for p in processes)
            if agent.get("name") == args.agent and agent.get("agent") == "codex":
                failure["outcome"] = ("started_not_ready" if agent.get("agent_status") == "blocked"
                                      else "started_unconfirmed")
            elif codex_running and registration_absent:
                failure["outcome"] = "started_unregistered"
            elif info and error_code == "agent_pane_busy" and not codex_running:
                failure["outcome"] = "not_started"
        with locked(lockfile):
            validate_launches([*read_records(logfile), failure])
            append_record(logfile, failure)
        print(f"启动未完成，保留 pane={pane} 交主控处置，launch={launch_id}，错误={error_code}，"
              f"结果={failure['outcome']}，不得盲目重试：{exc}",
              file=sys.stderr)
        return exc.returncode if isinstance(exc, subprocess.CalledProcessError) else 1
    row = dict(row, phase="started", pane=pane, agent=args.agent, herdr_start_argv=start_argv,
               herdr_result=started, observed_at=utc_now())
    with locked(lockfile):
        validate_launches(read_records(logfile))
        append_record(logfile, row)
    print(json.dumps(dict(launch_id=launch_id, pane=pane, agent=args.agent, argv=argv), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as exc:
        print("启动入口拒绝：" + str(exc), file=sys.stderr)
        sys.exit(1)
