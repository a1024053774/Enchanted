6a076","processId":"16642","source":"unifiedExecStartup","status":"inProgress","commandActions":[{"type":"unknown","command":"python3 - <<'PY'\nimport json\nimport subprocess\n\ncases = [\n    ('ordering and extra fields', {'items': [{'id': 'b', 'ts': 2, 'note': 'keep'}, {'id': 'a', 'ts': 1}], 'limit': 1}, {'items': [{'id': 'a', 'ts': 1}], 'next_cursor': [1, 'a']}),\n    ('strict cursor and final page', {'items': [{'id': 'a', 'ts': 1}, {'id': 'b', 'ts': 1}], 'limit': 2, 'after': [1, 'a']}, {'items': [{'id': 'b', 'ts': 1}], 'next_cursor': None}),\n    ('boolean limit', {'items': [], 'limit': True}, {'error': 'invalid_limit'}),\n    ('boolean cursor timestamp', {'items': [], 'limit': 1, 'after': [True, 'a']}, {'error': 'invalid_cursor'}),\n    ('limit validation first', {'items': [], 'limit': 0, 'after': 'bad'}, {'error': 'invalid_limit'}),\n]\nfailed = 0\nfor name, request, expected in cases:\n    result = subprocess.run(['python3', 'pager.py'], input=json.dumps(request), text=True, capture_output=True)\n    actual = json.loads(result.stdout) if result.returncode == 0 else {'exit_code': result.returncode}\n    if actual != expected:\n        failed += 1\n        print(f'RED {name}: actual={actual!r}, expected={expected!r}')\nassert failed == len(cases), f'Expected all starter checks to fail, got {failed}'\nprint(f'Confirmed {failed} contract failures in the starter.')\nPY"}],"aggregatedOutput":null,"exitCode":null,"durationMs":null},"threadId":"01a11a1f-5c40-70b3-be48-7a92f4c99e79","turnId":"01a11a1f-8399-74c2-a3fd-a583a7ddc520","startedAtMs":1791439684934},"providerInstanceId":"codex"}
