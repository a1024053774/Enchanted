\n+\n+    cursor = tuple(after) if after is not None else None\n+    eligible = sorted(\n+        (\n+            item\n+            for item in request[\"items\"]\n+            if cursor is None or (item[\"ts\"], item[\"id\"]) > cursor\n+        ),\n+        key=lambda item: (item[\"ts\"], item[\"id\"]),\n+    )\n+    page = eligible[:limit]\n+    next_cursor = (\n+        [page[-1][\"ts\"], page[-1][\"id\"]]\n+        if len(eligible) > limit\n+        else None\n+    )\n+    return {\"items\": page, \"next_cursor\": next_cursor}\n+\n+\n+if __name__ == \"__main__\":\n+    print(json.dumps(paginate(json.load(sys.stdin))))\n","exitCode":0,"durationMs":0},"threadId":"01a11a3f-7ec7-7643-84f7-d34ee23074a2","turnId":"01a11a3f-90d9-7111-a434-f439eeb218b1","completedAtMs":1791441831506},"providerInstanceId":"codex"}
