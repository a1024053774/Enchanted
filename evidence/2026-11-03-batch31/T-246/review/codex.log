     1	// T-242, T-246: what a terminal's Claude Code or Codex reported through its hook (a turn state, a native session), kept
     2	// per reporting process, and the process last seen in front. Only the front process's own report is shown, so a report
     3	// from another process (a CLI that exited while its hook was on the way, or one run inside the front one, such as
     4	// `claude -p` from its Bash tool) neither shows on the front one nor replaces what the front one reported.
     5	const processAlive = (pid: number) => {
     6	  try { process.kill(pid, 0); return true; } catch (error: any) { return error.code === "EPERM"; }
     7	};
     8	
     9	export class ByProcess<T> {
    10	  private byPid = new Map<number, T>();
    11	  private front: number | null = null;
    12	  private alive: (pid: number) => boolean;
    13	  constructor(alive = processAlive) { this.alive = alive; }
    14	  note(pid: number, value: T) { this.byPid.set(pid, value); this.prune(); }
    15	  foreground(pid: number | null) { this.front = pid; this.prune(); }
    16	  get(pid: number): T | undefined { return this.byPid.get(pid); }
    17	  shown(): T | null { return this.front === null ? null : this.byPid.get(this.front) ?? null; }
    18	  get size() { return this.byPid.size; }
    19	  // An exited process's report goes, so a later process given the same pid does not start with it.
    20	  private prune() { for (const pid of this.byPid.keys()) if (pid !== this.front && !this.alive(pid)) this.byPid.delete(pid); }
    21	}
