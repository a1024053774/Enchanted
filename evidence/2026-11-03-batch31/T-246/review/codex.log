// T-242, T-246: what a terminal's Claude Code or Codex reported through its hook (a turn state, a native session), kept
// per reporting process, and the process last seen in front. Only the front process's own report is shown, so a report
// from another process (a CLI that exited while its hook was on the way, or one run inside the front one, such as
// `claude -p` from its Bash tool) neither shows on the front one nor replaces what the front one reported.
const processAlive = (pid: number) => {
  try { process.kill(pid, 0); return true; } catch (error: any) { return error.code === "EPERM"; }
};

export class ByProcess<T> {
  private byPid = new Map<number, T>();
  private front: number | null = null;
  private alive: (pid: number) => boolean;
  constructor(alive = processAlive) { this.alive = alive; }
  note(pid: number, value: T) { this.byPid.set(pid, value); this.prune(); }
  foreground(pid: number | null) { this.front = pid; this.prune(); }
  get(pid: number): T | undefined { return this.byPid.get(pid); }
  shown(): T | null { return this.front === null ? null : this.byPid.get(this.front) ?? null; }
  get size() { return this.byPid.size; }
  // An exited process's report goes, so a later process given the same pid does not start with it.
  private prune() { for (const pid of this.byPid.keys()) if (pid !== this.front && !this.alive(pid)) this.byPid.delete(pid); }
}
