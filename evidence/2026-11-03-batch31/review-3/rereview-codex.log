    82	def fixture_processes(path):
    83	    """Live processes whose argv or environment names this fixture directory (ps -E shows our own processes'
    84	    environment, which carries the fixture HOME or operator credential even when argv does not)."""
    85	    listing = subprocess.run(['/bin/ps', '-axE', '-ww', '-o', 'pid=,command='], capture_output=True, text=True, check=True).stdout
    86	    pids = [int(line.split(None, 1)[0]) for line in listing.splitlines() if str(path) in line]
    87	    pids = [pid for pid in pids if pid != os.getpid()]
    88	    if not pids:
    89	        return []
    90	    shown = subprocess.run(['/bin/ps', '-ww', '-o', 'pid=,ppid=,command=', '-p', ','.join(map(str, pids))],
    91	                           capture_output=True, text=True).stdout
    92	    return [line.strip() for line in shown.splitlines() if line.strip()]
