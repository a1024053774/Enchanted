    61	def stop_fixture_core(state, path, env):
    62	    """After daemon_stop: stop the fixture's private core and fail if any process under path is left (T-232, T-243).
    63	    A daemon whose start passed the deadline is still running and can start the core after a first stop,
    64	    so stop it again while fixture processes remain."""
