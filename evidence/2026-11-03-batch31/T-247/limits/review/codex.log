    35	      "--model", model, "--effort", effort, ...extraDirectories.flatMap(path => ["--add-dir", path])], env: { AGY_CLI_OSC7501: "on" } }) },
    36	};
    37	
    38	// Which registered CLI a process runs, from its argv. A CLI installed as a script (npm) runs as `node <path>/<cli>`.
    39	const RUNTIMES = new Set(["node", "bun", "deno"]);
    40	export function cliProgram(argv: string[]): string | undefined {
    41	  const program = (index: number) => (argv[index] ?? "").split("/").at(-1)!;
    42	  const name = RUNTIMES.has(program(0)) ? program(1) : program(0);
    43	  return Object.hasOwn(terminalClis, name) ? name : undefined;
    44	}
    45	
    46	// ancestors: the argv of the command's ancestor processes, nearest first; read only when two CLIs claim it.
    47	export function commandCli(env: NodeJS.ProcessEnv, ancestors: () => string[][]): string | undefined {
    48	  const claimed = Object.keys(terminalClis).filter(name => terminalClis[name].inCommand(env));
    49	  if (claimed.length < 2) return claimed[0];
    50	  return ancestors().map(cliProgram).find(name => name !== undefined && claimed.includes(name));
    51	}
    52	
    53	// One OSC 7501 report: `ESC ] 7501 ; state=<s>[:id=..][:kind=<k>][:app=..][:msg=<base64>] (BEL | ESC \)`. A bare `?` is
    54	// the CLI asking whether the terminal supports it, not a state.
    55	// msg: the decoded text a report carries (agy: the question, the permission asked, the last reply).
    56	// app, id: the CLI's name and (opencode) its own session id, when the report carries them (T-195).
    57	export type CliTurn = { state: string; kind: string | null; msg: string | null; app: string | null; id: string | null };
    58	const OSC7501 = /\x1b\]7501;([^\x07\x1b]*)(?:\x07|\x1b\\)/g, START = "\x1b]7501;";
    59	export function readOsc7501(carry: string, data: string): { carry: string; turns: CliTurn[] } {
    60	  const text = carry + data, turns: CliTurn[] = [];
    61	  let end = 0;
    62	  for (const match of text.matchAll(OSC7501)) {
    63	    end = match.index! + match[0].length;
    64	    const fields = new Map(match[1].split(":").filter(field => field.includes("="))
    65	      .map(field => [field.slice(0, field.indexOf("=")), field.slice(field.indexOf("=") + 1)]));
    66	    if (fields.get("state")) turns.push({ state: fields.get("state")!, kind: fields.get("kind") ?? null,
    67	      msg: fields.has("msg") ? Buffer.from(fields.get("msg")!, "base64").toString("utf8") : null,
    68	      app: fields.get("app") || null, id: fields.get("id") || null });
    69	  }
    70	  // Keep an unfinished report for the next chunk, or an output that stops inside a report's opening `ESC ] 7501 ;`.
    71	  // A report is short, so anything longer is not one.
    72	  const report = text.lastIndexOf(START), escape = text.lastIndexOf("\x1b");
    73	  const from = report >= end ? report : escape >= end && START.startsWith(text.slice(escape)) ? escape : -1;
    74	  return { carry: from >= 0 && text.length - from < 4096 ? text.slice(from) : "", turns };
    75	}
    76	
    77	// The sidebar's reading of the last report. A permission prompt, a sign-in or anything not listed is not guessed.
    78	export function osc7501State(turn: CliTurn | null | undefined): "running" | "idle" | "waiting_user_answer" | "unknown" {
    79	  if (!turn) return "unknown";
    80	  if (turn.state === "working") return "running";
    81	  if (["idle", "done", "clear"].includes(turn.state)) return "idle";
    82	  return turn.state === "blocked" && turn.kind === "question" ? "waiting_user_answer" : "unknown";
    83	}

