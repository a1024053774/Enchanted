workbench/terminal/plugin/enchanted-a2a/hooks/hooks.json:5:    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"$A2A_TERMINAL_BIN/a2a\" hook", "timeout": 10 }] }],
workbench/terminal/plugin/enchanted-a2a/hooks/hooks.json:6:    "Stop": [{ "hooks": [{ "type": "command", "command": "\"$A2A_TERMINAL_BIN/a2a\" hook", "timeout": 10 }] }],
