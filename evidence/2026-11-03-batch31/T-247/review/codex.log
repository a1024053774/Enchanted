#!/bin/sh
# Enchanted shim (T-120): run the user's own codex with a short developer instruction
# that points to `a2a help`, unless the user passes developer_instructions themselves.
. "$(dirname "$0")/real-cli.sh"
real=$(a2a_real_cli codex) || exit 127
# T-133, T-107: Enchanted's hooks for this session only, as launch arguments. Codex asks the user to trust them once and
# keeps that trust in the user's own Codex config (a2a writes none); the definition never changes between terminals, so
# the trust holds. The command names the a2a shim through the terminal's environment, not a path of this install.
# No PostToolUse: Codex's ask tool returns before the user answers; the answer arrives as a submitted prompt.
hook='{type="command",command="\"$A2A_TERMINAL_BIN/a2a\" hook",timeout=10}'
# T-185: the same session-start orientation Claude's plugin gives (a2a session-context).
start='{type="command",command="\"$A2A_TERMINAL_BIN/a2a\" session-context",timeout=10}'
# T-194: the a2a commands as this session's MCP server. Codex gives an MCP server only the variables listed here; its
# tools need no approval prompt, the gate and the role the user approves in Enchanted decide; a role request waits up to
# 10 minutes for that approval.
mcp=mcp_servers.enchanted
# T-216: near the quota Codex ends a turn with a "switch model?" prompt while reporting done; the next inbox dispatch
# was pasted into it and its Enter switched the controller's model. Same setting as managed workers (T-167); the quota
# banner still shows, and a -c the user passes comes later and wins.
set -- -c "notice.hide_rate_limit_model_nudge=true" -c "hooks.SessionStart=[{hooks=[$start]}]" -c "hooks.UserPromptSubmit=[{hooks=[$hook]}]" -c "hooks.Stop=[{hooks=[$hook]}]" \
  -c "hooks.PreToolUse=[{matcher=\"request_user_input_async\",hooks=[$hook]}]" \
  -c "$mcp.command=\"$A2A_TERMINAL_BIN/a2a\"" -c "$mcp.args=[\"mcp\",\"codex\"]" \
  -c "$mcp.env_vars=[\"A2A_NODE\",\"A2A_TERMINAL_CLI\",\"A2A_TERMINAL_SOCKET\",\"A2A_TERMINAL\",\"A2A_TERMINAL_TOKEN\",\"CODEX_HOME\"]" \
  -c "$mcp.default_tools_approval_mode=\"approve\"" -c "$mcp.tool_timeout_sec=660" "$@"
# The user's own setting wins: a -c override, or the key in their Codex config file.
for argument in "$@"; do
  case $argument in developer_instructions=*|--config=developer_instructions=*) exec "$real" "$@" ;; esac
done
grep -q '^[[:space:]]*developer_instructions[[:space:]]*=' "${CODEX_HOME:-$HOME/.codex}/config.toml" 2>/dev/null && exec "$real" "$@"
exec "$real" -c "developer_instructions='这是 Enchanted 工作台的终端。用户让你担任主控、派发 worker、与其他 agent 通信时，先运行 a2a help，按它说明的命令操作；没有经过用户在界面批准的身份，不能使用主控命令。a2a request 会等用户批准最多 10 分钟，运行它时把命令超时设为 600 秒以上，否则命令被杀，申请随之撤回。'" "$@"
