    84	// The terminal socket accepts only this identity (T-126); the daemon's data directory is not in the environment.
    85	const socket = process.env.A2A_TERMINAL_SOCKET, launch = process.env.A2A_TERMINAL, token = process.env.A2A_TERMINAL_TOKEN;
    86	// Where the CLI keeps its records, from the environment it gives its commands.
    87	const nativeHome = (cli: string | undefined) => cli === "claude" ? process.env.CLAUDE_CONFIG_DIR || (process.env.HOME && process.env.HOME + "/.claude") :
    88	  cli === "codex" ? process.env.CODEX_HOME || (process.env.HOME && process.env.HOME + "/.codex") : undefined;
    89	const print = (value: unknown) => process.stdout.write(JSON.stringify(value, null, 2) + "\n");
