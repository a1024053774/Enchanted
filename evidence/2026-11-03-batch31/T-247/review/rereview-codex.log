+      // its hooks no CODEX_THREAD_ID, and a CLI started inside another inherits the outer one's variables.
+      const runner = ancestors().find(row => !SHELLS.has((row.argv[0] ?? "").split("/").at(-1)!.replace(/^-/, "")));
