    91	async function main(argv: string[]) {
    92	  const [command, ...rest] = argv;
    93	  if (!command || command === "help" || command === "--help" || command === "-h") {
    94	    process.stdout.write(usage + "\n");
    95	    return 0;
    96	  }
    97	  // T-133, T-107: the Enchanted plugin's hooks hand each event to the daemon. Whatever happens, it prints nothing
    98	  // (a UserPromptSubmit hook's output becomes the model's context) and exits 0, so it never changes the user's turn.
    99	  if (command === "hook" && !rest.length) {
   100	    try {
   101	      const chunks: Buffer[] = [];
   102	      for await (const chunk of process.stdin) chunks.push(chunk as Buffer);
   103	      // T-195, T-247: which CLI process runs this hook, so the session it names is bound to that process. A CLI starts
   104	      // its hooks itself, at most through a shell, so it is the first ancestor that is not a shell; when that one is no
   105	      // CLI we know, nothing is reported rather than a CLI further up. Not from the environment: interactive Codex gives
   106	      // its hooks no CODEX_THREAD_ID, and a CLI started inside another inherits the outer one's variables.
   107	      const runner = ancestors().find(row => !SHELLS.has((row.argv[0] ?? "").split("/").at(-1)!.replace(/^-/, "")));
   108	      const cli = runner && cliProgram(runner.argv), pid = runner?.pid;
   109	      if (socket && launch && token) await requestAt(socket, { command: "terminal_hook", raw_stdin: Buffer.concat(chunks).toString("utf8"),
   110	        ...(cli && pid ? { cli, cli_pid: pid, native_home: nativeHome(cli) } : {}) }, { kind: "terminal", launch, token });
   111	    } catch { /* The daemon decides what to keep; a hook that cannot reach it leaves the turn alone. */ }
   112	    return 0;
   113	  }
