    71	// This command's ancestor processes and their argv, nearest first (T-187: a CLI started inside another).
    72	function ancestors(): { pid: number; argv: string[] }[] {
    73	  const rows = new Map(execFileSync("/bin/ps", ["-axo", "pid=,ppid=,args="], { encoding: "utf8" }).split("\n")
    74	    .map(line => line.trim().match(/^(\d+)\s+(\d+)\s+(.*)$/)).filter(match => match !== null)
    75	    .map(match => [Number(match![1]), { parent: Number(match![2]), argv: match![3].split(/\s+/) }]));
    76	  const chain: { pid: number; argv: string[] }[] = [];
    77	  for (let pid = process.ppid; rows.has(pid) && chain.length < 64; pid = rows.get(pid)!.parent) chain.push({ pid, argv: rows.get(pid)!.argv });
    78	  return chain;
    79	}
