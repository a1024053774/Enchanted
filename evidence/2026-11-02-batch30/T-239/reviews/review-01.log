   118	  /**
   119	   * A finished session leaves out/report.md and then out/suggestions.json. Once both are there and the suggestions
   120	   * parse, the report goes to the project's findings/ (the data directory when the project has none) and each
   121	   * suggestion becomes a panel entry. Imported once per run.
   122	   */
   123	  importFinished() {
   124	    const imported: string[] = [];
   125	    const failOnce = (run: string, reason: string, error?: string) => {
   126	      if (!this.events(run).some(event => event.type === 'import_failed' && event.data.reason === reason)) this.record(run, 'import_failed', { reason, error });
   127	    };
   128	    for (const run of this.runs()) {
   129	      if (this.events(run.id).some(event => event.type === 'imported')) continue;
   130	      const report = join(run.out, 'report.md'), suggestions = join(run.out, 'suggestions.json');
   131	      if (!existsSync(report) || !existsSync(suggestions)) continue;
   132	      let parsed: unknown;
   133	      // Not JSON yet: the session may still be writing it, so the next check tries again. Recorded once, so a file
   134	      // that stays broken shows on the run instead of leaving it "in progress" without a word.
   135	      try { parsed = JSON.parse(readFileSync(suggestions, 'utf8')); } catch (error) {
   136	        failOnce(run.id, 'suggestions_not_json', String(error));
   137	        continue;
   138	      }
   139	      const list = Array.isArray(parsed) ? parsed : Array.isArray((parsed as any)?.suggestions) ? (parsed as any).suggestions : null;
   140	      if (!list) { failOnce(run.id, 'suggestions_not_a_list'); continue; }
   141	      const findings = join(run.repo, 'findings');
   142	      const destination = existsSync(findings) && statSync(findings).isDirectory()
   143	        ? join(findings, `${run.until.slice(0, 10)}-retrospective-${run.id.slice(0, 8)}.md`) : join(run.dir, 'report.md');
   144	      copyFileSync(report, destination);
   145	      // The suggestions and the "imported" mark go in together, so a failure part-way leaves nothing to duplicate on the next try.
   146	      this.db.exec('BEGIN IMMEDIATE');
   147	      try {
   148	        list.forEach((item: any, index: number) => {
   149	          const title = typeof item?.title === 'string' ? item.title.trim() : '';
   150	          if (!title) return;
   151	          const suggestion: Suggestion = { id: randomUUID(), run: run.id, project: run.project, number: index + 1, title,
   152	            body: typeof item.body === 'string' ? item.body : '', kind: typeof item.kind === 'string' ? item.kind : 'other', created_at: new Date().toISOString() };
   153	          this.db.prepare('INSERT INTO retrospective_suggestions(id,run,data) VALUES (?,?,?)').run(suggestion.id, run.id, JSON.stringify(suggestion));
   154	        });
   155	        this.record(run.id, 'imported', { report: destination, suggestions: list.length });
   156	        this.db.exec('COMMIT');
   157	      } catch (error) { this.db.exec('ROLLBACK'); throw error; }
   158	      imported.push(run.id);
   159	    }
   160	    return imported;
   161	  }
