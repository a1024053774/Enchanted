    31	    db.exec(`CREATE TABLE IF NOT EXISTS retrospective_schedule (seq INTEGER PRIMARY KEY AUTOINCREMENT, data TEXT NOT NULL);
    32	      CREATE TABLE IF NOT EXISTS retrospective_runs (seq INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT UNIQUE NOT NULL, project TEXT NOT NULL, data TEXT NOT NULL);
    33	      CREATE TABLE IF NOT EXISTS retrospective_events (seq INTEGER PRIMARY KEY AUTOINCREMENT, run TEXT NOT NULL, type TEXT NOT NULL, data TEXT NOT NULL, created_at TEXT NOT NULL);
    34	      CREATE TABLE IF NOT EXISTS retrospective_suggestions (seq INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT UNIQUE NOT NULL, run TEXT NOT NULL, data TEXT NOT NULL);
    35	      ${appendOnly('retrospective_schedule')} ${appendOnly('retrospective_runs')} ${appendOnly('retrospective_events')} ${appendOnly('retrospective_suggestions')}`);
