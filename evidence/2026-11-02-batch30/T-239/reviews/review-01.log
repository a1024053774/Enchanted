   106	  // reason changes, and the return to a known answer once, so a check that keeps failing does not repeat every minute.
   107	  noteEndCheck(run: string, seen: { front: string; reason?: string }) {
   108	    const last = this.events(run).filter(event => ['end_check_unknown', 'end_check_known'].includes(event.type)).at(-1);
   109	    if (seen.front === 'unknown') {
   110	      if (last?.type !== 'end_check_unknown' || last.data.reason !== seen.reason) this.record(run, 'end_check_unknown', seen);
