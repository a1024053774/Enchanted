    11	// the report and suggestions the session leaves. The session itself runs in an ordinary project terminal (daemon).
    12	export type RetrospectiveSchedule = { enabled: boolean; weekday: number; hour: number; minute: number;
    13	  cli: 'Claude Code' | 'Codex'; model: string; effort: string; effective_from: string };
    14	export type RetrospectiveRun = { id: string; project: string; repo: string; trigger: 'manual' | 'schedule'; scheduled_for: string | null;
    15	  since: string | null; until: string; cli: string; model: string; effort: string; dir: string; package: string; out: string;
    16	  created_at: string; launch?: string | null };
    17	type Suggestion = { id: string; run: string; project: string; number: number; title: string; body: string; kind: string; created_at: string };
    18	
    19	// The spec's defaults: every Monday 09:00, Claude Code with Opus 5.5 at medium effort; off until the user turns it on
    20	// on the Reflect page (user 2026-10-22, T-137).
    21	const defaults = { enabled: false, weekday: 1, hour: 9, minute: 0, cli: 'Claude Code' as const, model: 'claude-opus-5-5', effort: 'medium' };
    22	const json = (value: unknown) => JSON.parse(String(value));
    23	
    24	export class Retrospectives {
    25	  private db: DatabaseSync;
    26	  readonly root: string;
    27	  constructor(db: DatabaseSync, root: string) {
    28	    this.db = db; this.root = join(root, 'retrospectives');
    29	    const appendOnly = (table: string) => `CREATE TRIGGER IF NOT EXISTS ${table}_no_update BEFORE UPDATE ON ${table} BEGIN SELECT RAISE(ABORT,'append only'); END;
    30	      CREATE TRIGGER IF NOT EXISTS ${table}_no_delete BEFORE DELETE ON ${table} BEGIN SELECT RAISE(ABORT,'append only'); END;`;
    31	    db.exec(`CREATE TABLE IF NOT EXISTS retrospective_schedule (seq INTEGER PRIMARY KEY AUTOINCREMENT, data TEXT NOT NULL);
    32	      CREATE TABLE IF NOT EXISTS retrospective_runs (seq INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT UNIQUE NOT NULL, project TEXT NOT NULL, data TEXT NOT NULL);
    33	      CREATE TABLE IF NOT EXISTS retrospective_events (seq INTEGER PRIMARY KEY AUTOINCREMENT, run TEXT NOT NULL, type TEXT NOT NULL, data TEXT NOT NULL, created_at TEXT NOT NULL);
    34	      CREATE TABLE IF NOT EXISTS retrospective_suggestions (seq INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT UNIQUE NOT NULL, run TEXT NOT NULL, data TEXT NOT NULL);
    35	      ${appendOnly('retrospective_schedule')} ${appendOnly('retrospective_runs')} ${appendOnly('retrospective_events')} ${appendOnly('retrospective_suggestions')}`);
    36	    // The schedule takes effect from the moment it first exists: slots before installation never fire.
    37	    if (!db.prepare('SELECT 1 FROM retrospective_schedule LIMIT 1').get())
    38	      db.prepare('INSERT INTO retrospective_schedule(data) VALUES (?)').run(JSON.stringify({ ...defaults, effective_from: new Date().toISOString() }));
    39	  }
    40	
    41	  schedule(): RetrospectiveSchedule {
    42	    return json(this.db.prepare('SELECT data FROM retrospective_schedule ORDER BY seq DESC LIMIT 1').get()!.data);
    43	  }
    44	  saveSchedule(change: Partial<RetrospectiveSchedule>, now = new Date()) {
    45	    const current = this.schedule();
    46	    const next = { ...current, ...change, effective_from: now.toISOString() };
    47	    if (typeof next.enabled !== 'boolean' || ![0, 1, 2, 3, 4, 5, 6].includes(next.weekday) || !Number.isInteger(next.hour) || next.hour < 0 || next.hour > 23 ||
    48	      !Number.isInteger(next.minute) || next.minute < 0 || next.minute > 59 || !['Claude Code', 'Codex'].includes(next.cli) ||
    49	      typeof next.model !== 'string' || !next.model.trim() || typeof next.effort !== 'string' || !next.effort.trim()) throw new Error('invalid_retrospective_schedule');
    50	    this.db.prepare('INSERT INTO retrospective_schedule(data) VALUES (?)').run(JSON.stringify(next));
    51	    return next;
    52	  }
    53	
    54	  /** The latest scheduled slot at or before `now` (local time), when it is due for a project and has not run. */
    55	  due(project: string, now: Date) {
    56	    const schedule = this.schedule();
    57	    if (!schedule.enabled) return null;
    58	    // MakeDay resolves the numeric calendar date before UTC(t) applies the scheduled wall time.
    59	    // Never carry the query's wall time into the target date: a gap ending at midnight could
    60	    // normalize that intermediate time onto the next day. Reconstruct last week's date too.
    61	    // ECMAScript UTC(t) uses the pre-transition offset for gaps (advance by the gap) and the
    62	    // earlier instant for overlaps.
    63	    const year = now.getFullYear(), month = now.getMonth();
    64	    const day = now.getDate() - ((now.getDay() - schedule.weekday + 7) % 7);
    65	    let slot = new Date(year, month, day, schedule.hour, schedule.minute, 0, 0);
    66	    if (slot > now) slot = new Date(year, month, day - 7, schedule.hour, schedule.minute, 0, 0);
    67	    if (slot < new Date(schedule.effective_from)) return null;
    68	    const ran = this.runs(project).some(run => run.scheduled_for === slot.toISOString());
    69	    return ran ? null : slot.toISOString();
    70	  }
    71	
    72	  runs(project?: string): RetrospectiveRun[] {
    73	    return this.db.prepare(`SELECT data FROM retrospective_runs ${project ? 'WHERE project=?' : ''} ORDER BY seq`).all(...(project ? [project] : []))
    74	      .map(row => json(row.data));
    75	  }
    76	
    77	  /** Make a run: its range (from the project's last run to now), package, and the one directory the session may write. */
    78	  prepare(project: string, repo: string, selection: { cli: string; model: string; effort: string }, trigger: 'manual' | 'schedule',
    79	    scheduledFor: string | null, now = new Date(), range: { since?: string | null; until?: string | null } = {}): RetrospectiveRun {
    80	    const id = randomUUID();
    81	    const dir = join(this.root, id), out = join(dir, 'out');
    82	    mkdirSync(out, { recursive: true, mode: 0o700 });
    83	    // From the end of the last run that started: a run whose terminal never opened reviewed nothing (review 02).
    84	    const since = range.since !== undefined ? range.since
    85	      : this.runs(project).findLast(run => !this.events(run.id).some(event => event.type === 'start_failed'))?.until ?? null;
    86	    const until = range.until ?? now.toISOString();
    87	    const run: RetrospectiveRun = { id, project, repo, trigger, scheduled_for: scheduledFor, since, until, ...selection, dir,
    88	      package: join(dir, 'package.json'), out, created_at: now.toISOString() };
    89	    writeFileSync(run.package, JSON.stringify(retrospectivePackage(this.db, project, repo, since, until), null, 2) + '\n', { mode: 0o600 });
    90	    this.db.prepare('INSERT INTO retrospective_runs(id,project,data) VALUES (?,?,?)').run(id, project, JSON.stringify(run));
    91	    return run;
    92	  }
    93	  record(run: string, type: string, data: unknown) {
    94	    this.db.prepare('INSERT INTO retrospective_events(run,type,data,created_at) VALUES (?,?,?,?)').run(run, type, JSON.stringify(data), new Date().toISOString());
    95	  }
    96	  // T-237: runs whose terminal opened and that have neither been imported nor marked ended.
    97	  unfinished() {
    98	    return this.runs().flatMap(run => {
    99	      const events = this.events(run.id);
   100	      const started = events.find(event => event.type === 'started');
   101	      if (!started || events.some(event => ['imported', 'start_failed', 'ended'].includes(event.type))) return [];
   102	      return [{ run, launch: String(started.data.launch), startedAt: started.created_at }];
   103	    });
   104	  }
   105	  // T-237: an end check that cannot tell whether the run's CLI is still there is recorded when that starts or its
   106	  // reason changes, and the return to a known answer once, so a check that keeps failing does not repeat every minute.
   107	  noteEndCheck(run: string, seen: { front: string; reason?: string }) {
   108	    const last = this.events(run).filter(event => ['end_check_unknown', 'end_check_known'].includes(event.type)).at(-1);
   109	    if (seen.front === 'unknown') {
   110	      if (last?.type !== 'end_check_unknown' || last.data.reason !== seen.reason) this.record(run, 'end_check_unknown', seen);
   111	    } else if (last?.type === 'end_check_unknown') this.record(run, 'end_check_known', { front: seen.front });
   112	  }
   113	  events(run: string) {
   114	    return this.db.prepare('SELECT type, data, created_at FROM retrospective_events WHERE run=? ORDER BY seq').all(run)
   115	      .map(row => ({ type: String(row.type), data: json(row.data), created_at: String(row.created_at) }));
   116	  }
   117	
   118	  /**
   119	   * A finished session leaves out/report.md and then out/suggestions.json. Once both are there and the suggestions
   120	   * parse, the report goes to the project's findings/ (the data directory when the project has none) and each
   121	   * suggestion becomes a panel entry. Imported once per run.
   122	   */
   123	  importFinished() {
   124	    const imported: string[] = [];
   125	    const failOnce = (run: string, reason: string, error?: string) => {
   126	      if (!this.events(run).some(event => event.type === 'import_failed' && event.data.reason === reason)) this.record(run, 'import_failed', { reason, error });
   127	    };
   128	    for (const run of this.runs()) {
   129	      if (this.events(run.id).some(event => event.type === 'imported')) continue;
   130	      const report = join(run.out, 'report.md'), suggestions = join(run.out, 'suggestions.json');
   131	      if (!existsSync(report) || !existsSync(suggestions)) continue;
   132	      let parsed: unknown;
   133	      // Not JSON yet: the session may still be writing it, so the next check tries again. Recorded once, so a file
   134	      // that stays broken shows on the run instead of leaving it "in progress" without a word.
   135	      try { parsed = JSON.parse(readFileSync(suggestions, 'utf8')); } catch (error) {
   136	        failOnce(run.id, 'suggestions_not_json', String(error));
   137	        continue;
   138	      }
   139	      const list = Array.isArray(parsed) ? parsed : Array.isArray((parsed as any)?.suggestions) ? (parsed as any).suggestions : null;
   140	      if (!list) { failOnce(run.id, 'suggestions_not_a_list'); continue; }
   141	      const findings = join(run.repo, 'findings');
   142	      const destination = existsSync(findings) && statSync(findings).isDirectory()
   143	        ? join(findings, `${run.until.slice(0, 10)}-retrospective-${run.id.slice(0, 8)}.md`) : join(run.dir, 'report.md');
   144	      copyFileSync(report, destination);
   145	      // The suggestions and the "imported" mark go in together, so a failure part-way leaves nothing to duplicate on the next try.
   146	      this.db.exec('BEGIN IMMEDIATE');
   147	      try {
   148	        list.forEach((item: any, index: number) => {
   149	          const title = typeof item?.title === 'string' ? item.title.trim() : '';
   150	          if (!title) return;
   151	          const suggestion: Suggestion = { id: randomUUID(), run: run.id, project: run.project, number: index + 1, title,
   152	            body: typeof item.body === 'string' ? item.body : '', kind: typeof item.kind === 'string' ? item.kind : 'other', created_at: new Date().toISOString() };
   153	          this.db.prepare('INSERT INTO retrospective_suggestions(id,run,data) VALUES (?,?,?)').run(suggestion.id, run.id, JSON.stringify(suggestion));
   154	        });
   155	        this.record(run.id, 'imported', { report: destination, suggestions: list.length });
   156	        this.db.exec('COMMIT');
   157	      } catch (error) { this.db.exec('ROLLBACK'); throw error; }
   158	      imported.push(run.id);
   159	    }
   160	    return imported;
   161	  }
   162	
   163	  suggestions(project: string) {
   164	    const decisions = new Map<string, any>();
   165	    for (const row of this.db.prepare("SELECT data FROM retrospective_events WHERE type='suggestion_decided' ORDER BY seq").all()) {
   166	      const data = json(row.data);
   167	      decisions.set(data.suggestion, data);
   168	    }
   169	    return this.db.prepare('SELECT data FROM retrospective_suggestions ORDER BY seq').all().map(row => json(row.data) as Suggestion)
   170	      .filter(item => item.project === project).map(item => ({ ...item, decision: decisions.get(item.id) ?? null }));
   171	  }
   172	  decide(suggestion: string, approved: boolean) {
   173	    const row = this.db.prepare('SELECT data FROM retrospective_suggestions WHERE id=?').get(suggestion);
   174	    if (!row) throw new Error('unknown_suggestion');
   175	    const item = json(row.data) as Suggestion;
   176	    if (this.suggestions(item.project).find(entry => entry.id === suggestion)?.decision) throw new Error('suggestion_already_decided');
   177	    const decision = { suggestion, approved, decided_at: new Date().toISOString() };
   178	    this.record(item.run, 'suggestion_decided', decision);
   179	    return { ...item, decision };
   180	  }
   181	}
   182	
   183	/** Everything a retrospective reads for one project and time range, from the records (spec section 8). */
   184	export function retrospectivePackage(db: DatabaseSync, project: string, repo: string, since: string | null, until: string) {
   185	  const inRange = (time: string) => (!since || time >= since) && time < until;
   186	  const tasks = db.prepare('SELECT id, data FROM tasks').all().map(row => json(row.data)).filter(task => task.project_id === project);
   187	  const ids = new Set(tasks.map(task => task.task_id));
   188	  const events = db.prepare('SELECT seq, time, task, attempt, type, details FROM events ORDER BY seq').all()
   189	    .filter(row => ids.has(String(row.task)) && inRange(String(row.time)))
   190	    .map(row => ({ seq: Number(row.seq), time: String(row.time), task: String(row.task), attempt: row.attempt ?? null, type: String(row.type), details: json(row.details) }));
   191	  const touched = new Set(events.map(event => event.task));
   192	  const of = (...types: string[]) => events.filter(event => types.includes(event.type));
   193	  const issues = db.prepare('SELECT data FROM issue_records ORDER BY rowid').all().map(row => json(row.data))
   194	    .filter(record => ids.has(record.task_id) && inRange(record.created_at));
   195	  const launches = db.prepare('SELECT data FROM launch_records ORDER BY rowid').all().map(row => json(row.data))
   196	    .filter(record => record.project === project);
   197	  // Sessions archived during the range, with what was archived by its end (T-136 review 01: not every session ever).
   198	  const archive = db.prepare('SELECT launch, source, file, max(end) AS end FROM trajectory_archive WHERE created_at < ? GROUP BY launch, source HAVING max(created_at) >= ?')
   199	    .all(until, since ?? '')
   200	    .filter(row => launches.some(record => record.id === row.launch))
   201	    .map(row => ({ launch: String(row.launch), role: launches.find(record => record.id === row.launch)?.role ?? null,
   202	      native: String(row.source), archive: String(row.file), archived_bytes: Number(row.end) }));
   203	  return {
   204	    schema: 1, project, repo, since, until, generated_at: new Date().toISOString(),
   205	    tasks: tasks.filter(task => touched.has(task.task_id)).map(task => ({ task: task.task_id, title: task.title ?? null, state: task.state,
   206	      task_type: task.card?.task_type ?? null, complexity: task.card?.complexity ?? null })),
   207	    gate_checks: of('verification_result', 'delivery_rejected', 'rejected', 'rule_check', 'red_check', 'completion_check', 'integration_compare_failed')
   208	      .map(event => ({ time: event.time, task: event.task, type: event.type,
   209	        check: event.details?.repair?.check ?? event.details?.check ?? null,
   210	        result: event.details?.verification?.state ?? event.details?.error ?? event.details?.result?.state ?? null })),
   211	    rejections: of('delivery_rejected').map(event => ({ time: event.time, task: event.task, check: event.details.repair?.check, count: event.details.repair?.count })),
   212	    reviews: of('review_result').map(event => ({ time: event.time, task: event.task, state: event.details.review?.state ?? null,
   213	      verdict: event.details.review?.result?.verdict ?? null, findings: event.details.review?.result?.findings ?? [] })),
   214	    scores: of('score_recorded').map(event => event.details),
   215	    issues: issues.filter(record => record.kind === 'issue').map(record => ({ id: record.id, task: record.task_id, from: record.from,
   216	      title: record.title, blocking: record.blocking, created_at: record.created_at })),
   217	    panel: issues.filter(record => record.kind !== 'issue').map(record => ({ issue: record.issue_id, kind: record.kind, from: record.from,
   218	      action: record.action ?? null, body: record.body, created_at: record.created_at })),
   219	    user_inputs: userInputRecords(db, project).filter(input => inRange(input.created_at)),
   220	    commit_trailers: commitTrailers(repo, since, until),
   221	    metrics: metricsSnapshot(db, { project, since, until }),
   222	    trajectory_archive: archive,
   223	  };
   224	}
   225	
   226	// The A2A trailers of the commits in range on the project's branches; commits without them are counted apart.
   227	function commitTrailers(repo: string, since: string | null, until: string) {
   228	  let log = '';
   229	  try {
   230	    log = execFileSync('git', ['-C', repo, 'log', '--all', `--until=${until}`, ...(since ? [`--since=${since}`] : []),
   231	      '--format=%H%x1f%cI%x1f%(trailers:only,unfold)%x1e'], { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
   232	  } catch (error) { return { error: String(error), commits: [], without_trailers: null }; }
   233	  const commits = log.split('\x1e').map(entry => entry.trim()).filter(Boolean).map(entry => {
   234	    const [commit, time, trailers = ''] = entry.split('\x1f');
   235	    const values = Object.fromEntries(trailers.split('\n').map(line => /^A2A-([A-Za-z-]+):\s*(.*)$/.exec(line.trim())).filter(Boolean)
   236	      .map(match => [match![1], match![2]]));
   237	    return { commit, time, trailers: values };
   238	  });
   239	  return { commits, without_trailers: commits.filter(entry => !Object.keys(entry.trailers).length).length };
   240	}
    65	    // The start failure is what stops the daemon; a failed event write must not replace it.
    66	    try { store.event("hc_start_failed", { reason: String(error) }); }
    67	    catch (recordError) { throw new AggregateError([error, recordError], `hc start failed (${String(error)}) and hc_start_failed was not recorded`); }
    68	    throw error;
    69	  }
    70	  gates.openedProjectRepo = project => store.openedProjects().find(opened => opened.project_id === project)?.repo;
    71	  const relay = new RequestRelay(store);
    72	  const roleRequests = new RoleRequests(store, launch => panes.terminalAlive(launch));
    73	  panes.approvedController = thread => {
    74	    const record = store.launches().find(record => record.thread === thread);
    75	    const held = record && roleRequests.approved(record.id);
    76	    return held ? { role: held.role, project: held.project, cli: held.cli } : undefined;
    77	  };
    78	  panes.controllerReady = (thread, role, project) => gates.resumeControllerInbox(thread, role, project);
    79	  // T-229: a managed Claude Code or Codex pane's submission, as its UserPromptSubmit hook reported it. One hook call is one
    80	  // submission (a Claude prompt queued during a turn shares that turn's prompt id), so each record gets an id of its own.
    81	  panes.recordUserSubmission = (pane, text, received_at) => gates.appendUserInput({ id: randomUUID(), schema: 1, form: "message", text,
    82	    target: { project: pane.record.project, task: pane.record.task, attempt: pane.record.attempt, thread: pane.record.thread,
    83	      turn: pane.turn, message: null, request: null },
    84	    channel: "terminal-window", reply_to: null, certainty: "observed", created_at: received_at,
    85	    source_ref: { label: pane.record.id } }, `hook:${pane.record.id}:${randomUUID()}`);
    86	  // A terminal controller's usage limit, read from its own session log (T-124).
    87	  const quota = new ControllerQuota(store);
    88	  const quotaTimer = setInterval(() => {
    89	    try { quota.tick(roleRequests.all().filter(roleRequest => roleRequest.state === "approved")); }
    90	    catch (error) { console.error(JSON.stringify({ error: "controller_quota_failed", reason: String(error) })); }
    91	  }, 5000);
    92	  quotaTimer.unref();
    93	  // Trajectory archive (T-135): after every Claude turn of the session, and every 30 s for everything else. A failed
    94	  // increment is recorded and retried by the next sweep; it never fails the hook or the daemon.
    95	  const archive = new TrajectoryArchive(store.db, root, (type, data, launch) => store.event(type, data, { id: launch, task: null }));
    96	  const archiveSweep = (launch?: string) => {
    97	    try { archive.sweep(launch); }
    98	    catch (error) { store.event("trajectory_archive_failed", { error: String(error) }, launch ? { id: launch, task: null } : undefined); }
    99	  };
   100	  const archiveTimer = setInterval(() => archiveSweep(), 30_000);
   101	  archiveTimer.unref();
   102	  // Retrospectives (T-136): started by the user or the weekly schedule, run in an ordinary project terminal the daemon
   103	  // opens; the schedule is checked and finished runs imported every minute (and on retrospective_tick, whose `now`
   104	  // a test may set).
   105	  const retrospectives = new Retrospectives(store.db, root);
   106	  const startRetrospective = async (project: string, selection: { cli: string; model: string; effort: string },
   107	    trigger: "manual" | "schedule", scheduledFor: string | null, now: Date, range?: { since?: string | null; until?: string | null }) => {
   108	    const opened = store.openedProjects().find(entry => entry.project_id === project);
   109	    if (!opened) throw new Refusal("unknown_project");
   110	    if (!["Claude Code", "Codex"].includes(selection.cli) || typeof selection.model !== "string" || !selection.model.trim() ||
   111	      typeof selection.effort !== "string" || !selection.effort.trim()) throw new Refusal("invalid_retrospective_selection");
   112	    const run = retrospectives.prepare(project, opened.repo, selection, trigger, scheduledFor, now, range);
   113	    const session = randomUUID();
   114	    const argv = retrospectiveArgv(run, config, retrospectivePrompt(run, root), session);
   115	    // The run is recorded before its terminal opens, so its slot is taken; a start that fails says so on the run
   116	    // (T-136 review 01) instead of leaving it "in progress". It is not retried by itself: the user can start one.
   117	    try {
   118	      const shell = await panes.startShell(project, opened.repo);
   119	      store.event("retrospective_started", { run: run.id, cli: run.cli, model: run.model, effort: run.effort, argv,
   120	        native_session: run.cli === "Claude Code" ? session : null,
   121	        native_home: run.cli === "Claude Code" ? process.env.CLAUDE_CONFIG_DIR ?? join(process.env.HOME ?? "", ".claude")
   122	          : process.env.CODEX_HOME ?? join(process.env.HOME ?? "", ".codex"),
   123	        package: run.package, out: run.out }, shell);
   124	      retrospectives.record(run.id, "started", { launch: shell.id, native_session: run.cli === "Claude Code" ? session : null });
   125	      await panes.runInShell(shell.id, argv);
   126	      return { ...run, launch: shell.id };
   127	    } catch (error) {
   128	      retrospectives.record(run.id, "start_failed", { error: String(error) });
   129	      throw error;
   130	    }
   131	  };
   132	  const retrospectiveTick = async (now: Date) => {
   133	    const started = [];
   134	    for (const project of store.openedProjects()) {
   135	      const slot = retrospectives.due(project.project_id, now);
   136	      if (!slot) continue;
   137	      const schedule = retrospectives.schedule();
   138	      // A project whose run fails to start has it recorded on the run; the others and the import still go ahead.
   139	      try { started.push(await startRetrospective(project.project_id, schedule, "schedule", slot, now)); }
   140	      catch (error) { store.event("retrospective_tick_failed", { project: project.project_id, error: String(error) }); }
   141	    }
   142	    const imported = retrospectives.importFinished();
   143	    // T-237: a run that was not imported and whose terminal's close is recorded, or that is back at its prompt a
   144	    // minute after the start (the CLI has exited or never ran), has ended without a report. A program in front keeps
   145	    // it in progress, and so does an answer that cannot be had (recorded on the run): no end is decided while the
   146	    // daemon is still restoring terminals, nor for a terminal it could not restore.
   147	    const ended = [];
   148	    if (!recovering) for (const { run, launch, startedAt } of retrospectives.unfinished()) {
