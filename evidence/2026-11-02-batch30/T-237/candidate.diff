+++ b/workbench/src/retrospective.ts
@@ -93,6 +93,15 @@ export class Retrospectives {
   record(run: string, type: string, data: unknown) {
     this.db.prepare('INSERT INTO retrospective_events(run,type,data,created_at) VALUES (?,?,?,?)').run(run, type, JSON.stringify(data), new Date().toISOString());
   }
+  // T-237: runs whose terminal opened and that have neither been imported nor marked ended.
+  unfinished() {
+    return this.runs().flatMap(run => {
+      const events = this.events(run.id);
+      const started = events.find(event => event.type === 'started');
+      if (!started || events.some(event => ['imported', 'start_failed', 'ended'].includes(event.type))) return [];
+      return [{ run, launch: String(started.data.launch), startedAt: started.created_at }];
+    });
+  }
   events(run: string) {
     return this.db.prepare('SELECT type, data, created_at FROM retrospective_events WHERE run=? ORDER BY seq').all(run)
       .map(row => ({ type: String(row.type), data: json(row.data), created_at: String(row.created_at) }));
diff --git a/workbench/tests/test_t237_retrospective_end_e2e.py b/workbench/tests/test_t237_retrospective_end_e2e.py
new file mode 100644
index 0000000000..93141487c8
--- /dev/null
+++ b/workbench/tests/test_t237_retrospective_end_e2e.py
@@ -0,0 +1,229 @@
+"""T-237：复盘的 CLI 退出、或它的终端已不在之后，复盘不再一直显示“进行中”。真实后台、门禁 CLI、项目终端与 zsh；
+复盘的 CLI 换成本地替身脚本（按控制文件决定退出、一直运行、或写出报告后退出），无 Electron、无模型。
+
+场景（期望来自 ticket：CLI 退出或终端不在时显示已结束；没退出的、写出了报告的照旧）：
+A. 替身启动 1 秒后退出，什么都不写。启动后 5 秒的检查仍算进行中（CLI 可能还没起来）；61 秒的检查记为 ended（cli_not_running）。
+B. 替身一直运行、不输出。61 秒的检查仍是进行中。
+C. 替身写出 report.md、suggestions.json 后退出。61 秒的检查导入（已完成），不记 ended。
+D. 后台停止、它的 core 与终端里的程序都被结束（第二轮实测的情形）后重启再检查，B 记为 ended（terminal_gone）；A 的 ended 只有一条。
+
+失败方式（先列再写）：
+1. CLI 退出后一直显示进行中（修前的缺陷）。
+2. 后台重启后终端已不在，仍显示进行中。
+3. 过头：还在运行、只是没输出的 CLI 被记成结束。
+4. 写完报告再退出的复盘被记成结束，而不是导入。
+5. 刚启动、CLI 还没 exec 时的检查就把它记成结束。
+6. 每次检查都重复记一条 ended。
+--revision 在该版本源码上跑（修前应失败）；--mutant 跑已知坏实现。
+"""
+import argparse
+from datetime import datetime, timedelta, timezone
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+import uuid
+
+ROOT = Path(__file__).resolve().parents[2]
+FAKE = r'''#!/usr/bin/python3
+import json, sys, time
+from pathlib import Path
+args = sys.argv
+out = Path(json.loads(args[args.index('--settings') + 1])['sandbox']['filesystem']['allowWrite'][0])
+mode = Path(%r).read_text().strip()
+(out / 'fake-started').write_text(mode)
+if mode == 'exit':
+    time.sleep(1)
+elif mode == 'sleep':
+    time.sleep(3600)
+elif mode == 'report':
+    (out / 'report.md').write_text('# 复盘\n\nT-237 替身报告。\n')
+    (out / 'suggestions.json').write_text(json.dumps([{'title': 'T-237 建议', 'body': '', 'kind': 'other'}], ensure_ascii=False))
+'''
+MUTANTS = {
+    # Known-bad: nothing checks the terminal (the defect as reported).
+    'no-end-check': [('src/daemon.ts', 'for (const { run, launch, startedAt } of retrospectives.unfinished()) {',
+                      'for (const { run, launch, startedAt } of [] as ReturnType<typeof retrospectives.unfinished>) {')],
+    # Known-bad: an empty prompt ends the run at once, before the CLI had time to start.
+    'no-grace': [('src/daemon.ts', ' || (front === "prompt" && now.getTime() - Date.parse(startedAt) < RETROSPECTIVE_START_GRACE_MS)', '')],
+    # Known-bad: a gone terminal counts as still running.
+    'gone-is-running': [('src/panes.ts', 'if (!pane || pane.stopped) return "gone";', 'if (!pane || pane.stopped) return "program";')],
+    # Known-bad: the end check runs before the import, so a run that wrote its report is also marked ended.
+    'end-before-import': [('src/daemon.ts', '    const imported = retrospectives.importFinished();\n', ''),
+                          ('src/daemon.ts', '    return { started, imported, ended };', '    const imported = retrospectives.importFinished();\n    return { started, imported, ended };')],
+}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--summary', type=Path, required=True)
+    target = parser.add_mutually_exclusive_group()
+    target.add_argument('--revision')
+    target.add_argument('--mutant', choices=sorted(MUTANTS))
+    args = parser.parse_args()
+    assert not args.summary.exists(), '保留既有证据，改用新路径'
+    fixture = Path(tempfile.mkdtemp(prefix='t237-', dir='/private/tmp')).resolve()
+    state, home, repo = fixture / 'state', fixture / 'home', fixture / 'demo'
+    for path in (state, home):
+        path.mkdir()
+    (home / '.zshrc').write_text("PS1='T237% '\n", encoding='utf-8')
+    source = ROOT
+    if args.revision or args.mutant:
+        source = fixture / 'source'
+        if args.revision:
+            for name in subprocess.check_output(['git', 'ls-tree', '-r', '--name-only', args.revision, 'workbench/src'],
+                                                cwd=ROOT, text=True).splitlines():
+                path = source / name
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_bytes(subprocess.check_output(['git', 'show', f'{args.revision}:{name}'], cwd=ROOT))
+        else:
+            shutil.copytree(ROOT / 'workbench/src', source / 'workbench/src')
+            for relative, old, new in MUTANTS[args.mutant]:
+                path = source / 'workbench' / relative
+                text = path.read_text(encoding='utf-8')
+                assert text.count(old) == 1, f'变异定位必须唯一：{old}'
+                path.write_text(text.replace(old, new), encoding='utf-8')
+        (source / 'workbench/node_modules').symlink_to(ROOT / 'workbench/node_modules', target_is_directory=True)
+    cli = source / 'workbench/src/gates/cli.ts'
+    mode = fixture / 'mode'
+    fake = fixture / 'claude'
+    fake.write_text(FAKE % str(mode), encoding='utf-8')
+    fake.chmod(0o755)
+    (fixture / 'launch-config.json').write_text(json.dumps(dict(claude_bin=str(fake))), encoding='utf-8')
+    env = {key: os.environ[key] for key in ['PATH', 'LANG', 'TMPDIR'] if key in os.environ}
+    # A copied source tree resolves the hc archive cache inside the fixture; point it at the checkout's cache.
+    env['ENCHANTED_HC_CACHE_DIR'] = os.environ.get('ENCHANTED_HC_CACHE_DIR') or str(ROOT.parent / 'hc-cache')
+    env.update(HOME=str(home), SHELL='/bin/zsh', TERM='xterm-256color', A2A_OPERATOR_CREDENTIAL=str(fixture / 'operator.json'),
+               GIT_AUTHOR_NAME='fixture', GIT_AUTHOR_EMAIL='fixture@example.invalid',
+               GIT_COMMITTER_NAME='fixture', GIT_COMMITTER_EMAIL='fixture@example.invalid')
+    report = dict(status='INCOMPLETE', argv=sys.argv, revision=args.revision, mutant=args.mutant, fixture=str(fixture), checks=[], observed={})
+    running = False
+
+    def run_cli(*arguments):
+        run = subprocess.run(['node', str(cli), '--state', str(state), *arguments], env=env, capture_output=True, text=True, timeout=60)
+        assert run.returncode == 0, f'{arguments[0]}: {run.stderr or run.stdout}'
+        return json.loads(run.stdout)
+
+    def request(command, identity=None, **data):
+        with socket.socket(socket.AF_UNIX) as connection:
+            connection.settimeout(60)
+            connection.connect(str(state / 'control.sock'))
+            connection.sendall((json.dumps(dict(id=str(uuid.uuid4()), input=dict(command=command, **data), identity=identity)) + '\n').encode())
+            response = b''
+            while b'\n' not in response:
+                part = connection.recv(65536)
+                assert part, 'daemon 在回执前断开'
+                response += part
+        return json.loads(response.split(b'\n', 1)[0])
+
+    def wait(label, predicate, timeout=30):
+        deadline = time.monotonic() + timeout
+        while not (value := predicate()):
+            assert time.monotonic() < deadline, f'超时：{label}'
+            time.sleep(.2)
+        return value
+
+    def check(name, condition, detail=None):
+        assert condition, f'{name}: {detail}'
+        report['checks'].append(name)
+
+    def start_daemon():
+        run_cli('daemon_start', '--launch-config', str(fixture / 'launch-config.json'))
+        wait('后台恢复结束', lambda: request('pane_layout').get('recovering') is False, 10)
+        return json.loads((fixture / 'operator.json').read_text(encoding='utf-8'))
+
+    def kill_fixture_processes():
+        # Only processes started for this fixture: their command lines name its directory.
+        subprocess.run(['pkill', '-f', str(fixture)], check=False)
+        wait('夹具进程退出', lambda: subprocess.run(['pgrep', '-f', str(fixture)], capture_output=True).returncode == 1, 15)
+
+    def runs():
+        listing = request('retrospective_list', operator, project='demo')
+        assert listing['ok'], listing
+        return {run['id']: run for run in listing['runs']}
+
+    def kinds(run_id):
+        return [event['type'] for event in runs()[run_id]['events']]
+
+    def start(kind):
+        mode.write_text(kind, encoding='utf-8')
+        started = request('retrospective_start', operator, project='demo', cli='Claude Code', model='fixture-model', effort='low')
+        assert started['ok'], started
+        run = started['run']
+        wait(f'替身 {kind} 启动', lambda: (Path(run['out']) / 'fake-started').exists())
+        return run['id'], datetime.fromisoformat(next(e['created_at'] for e in runs()[run['id']]['events'] if e['type'] == 'started').replace('Z', '+00:00'))
+
+    def tick(when):
+        result = request('retrospective_tick', operator, now=when.astimezone(timezone.utc).isoformat().replace('+00:00', 'Z'))
+        assert result['ok'], result
+        return result
+
+    try:
+        operator = start_daemon()
+        running = True
+        subprocess.run(['git', 'init', '-q', '-b', 'main', str(repo)], check=True, env=env)
+        (repo / 'README.md').write_text('demo\n', encoding='utf-8')
+        subprocess.run(['git', '-C', str(repo), 'add', '.'], check=True, env=env)
+        subprocess.run(['git', '-C', str(repo), 'commit', '-q', '-m', 'init'], check=True, env=env)
+        assert request('project_open', operator, repo=str(repo))['ok']
+
+        run_a, at_a = start('exit')
+        run_b, at_b = start('sleep')
+        time.sleep(3)  # A has exited; B is still running.
+        tick(at_a + timedelta(seconds=5))
+        report['observed']['early'] = {name: kinds(run) for name, run in (('A', run_a), ('B', run_b))}
+        check('exited_cli_not_ended_within_grace', 'ended' not in kinds(run_a), kinds(run_a))
+        # C starts after that check, so its import and its end check fall in the same later check.
+        run_c, at_c = start('report')
+        time.sleep(3)  # C has written its files and exited.
+        late = max(at_a, at_b, at_c) + timedelta(seconds=61)
+        tick(late)
+        tick(late + timedelta(seconds=60))
+        report['observed']['late'] = {name: runs()[run]['events'] for name, run in (('A', run_a), ('B', run_b), ('C', run_c))}
+        ended_a = [e for e in runs()[run_a]['events'] if e['type'] == 'ended']
+        check('exited_cli_marked_ended', len(ended_a) == 1 and ended_a[0]['data'].get('reason') == 'cli_not_running', ended_a)
+        check('running_cli_stays_in_progress', 'ended' not in kinds(run_b), kinds(run_b))
+        check('reported_run_imported_not_ended', 'imported' in kinds(run_c) and 'ended' not in kinds(run_c), kinds(run_c))
+
+        run_cli('daemon_stop')
+        running = False
+        wait('后台停止', lambda: not (state / 'control.sock').exists(), 15)
+        (fixture / 'operator.json').unlink()  # each daemon start issues a new operator credential
+        # The core outlives a daemon restart by design (B's terminal would be restored, still running). Kill the
+        # fixture's core and programs while the daemon is down, as in the reported case, so B's terminal is gone.
+        kill_fixture_processes()
+        operator = start_daemon()
+        running = True
+        tick(late + timedelta(seconds=120))
+        report['observed']['after_restart'] = {name: runs()[run]['events'] for name, run in (('A', run_a), ('B', run_b))}
+        ended_b = [e for e in runs()[run_b]['events'] if e['type'] == 'ended']
+        check('gone_terminal_marked_ended', len(ended_b) == 1 and ended_b[0]['data'].get('reason') == 'terminal_gone', ended_b)
+        check('ended_recorded_once', kinds(run_a).count('ended') == 1, kinds(run_a))
+        report['status'] = 'PASS'
+    except Exception as error:
+        report['error'] = f'{type(error).__name__}: {error}'
+    finally:
+        if running:
+            try:
+                run_cli('daemon_stop')
+                deadline = time.monotonic() + 10
+                while (state / 'control.sock').exists() and time.monotonic() < deadline:
+                    time.sleep(.05)
+            except Exception as error:
+                report['cleanup_error'] = str(error)
+        try: kill_fixture_processes()
+        except Exception as error: report['cleanup_error'] = f"{report.get('cleanup_error', '')} {error}".strip()
+        args.summary.parent.mkdir(parents=True, exist_ok=True)
+        args.summary.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
+        shutil.rmtree(fixture, ignore_errors=True)
+    print(json.dumps({key: report[key] for key in ('status', 'checks', 'error') if key in report}, ensure_ascii=False))
+    return 0 if report['status'] == 'PASS' else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
