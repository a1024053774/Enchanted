     with trace_path.open("x", encoding="utf-8") as out:
         json.dump(trace, out, ensure_ascii=False, indent=2)
         out.write("\n")
     return 0 if result.wasSuccessful() else 1
 
 
 def main():
     if sys.argv[1:] == ["--run-suite"]:
