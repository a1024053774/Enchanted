+++ b/workbench/tests/test_relay_scope.ts
@@ -0,0 +1,94 @@
+// Independent request-boundary contracts; real relay and SQLite, counted gate
+// effects only. Full daemon/CLI coverage is a separate controlled experiment.
+// Failure modes: cross-owner ID collision, same-owner duplicate effects,
+// payload substitution, replay of a pending intent, or forgotten legacy intent.
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { OrchestrationStore } from "../src/store.ts";
+const [modulePath, output] = process.argv.slice(2);
+assert(modulePath && output && process.argv.length === 4);
+mkdirSync(output);
+const { RequestRelay } = await import(pathToFileURL(modulePath).href);
+const results: any[] = [];
+const first = { id: "launch-one", task: "fixture", attempt: "attempt-one", session: "session-one", fence: 1, spec_rev: 1, role: "worker" };
+const next = { id: "launch-two", task: "fixture", attempt: "attempt-two", session: "session-two", fence: 2, spec_rev: 1, role: "worker" };
+function input(binding: any, request_id = "delivery", commit = "a".repeat(40)) {
+  const { id: _id, role: _role, ...identity } = binding;
+  return { schema: 1, request_id, command: "submit", ...identity, commit };
+}
+function file(value: any, name = "delivery.json") { return { name, raw: JSON.stringify(value) }; }
+async function check(name: string, body: (relay: any, store: any, effects: any[], perform: any) => Promise<void>) {
+  const root = mkdtempSync("/tmp/t077-relay-scope-");
+  const store = new OrchestrationStore(root), relay = new RequestRelay(store), effects: any[] = [];
+  const perform = async (command: any) => { effects.push(command); return { ok: true, applied: command.commit }; };
+  let failure: any = null;
+  try { await body(relay, store, effects, perform); }
+  catch (error) { failure = { assertion: error instanceof assert.AssertionError, text: String(error) }; }
+  const tables = Object.fromEntries(["relay_requests", "relay_results"].map((name) => [name, store.db.prepare("SELECT * FROM " + name).all()]));
+  results.push({ name, root, pass: !failure, failure, effects, tables, events: store.read() });
+  store.close();
+}
+await check("new_attempt_same_id_is_new_delivery", async (relay, store, effects, perform) => {
+  assert.equal((await relay.receive(first, file(input(first)), true, perform)).result.ok, true);
+  const original = store.db.prepare("SELECT * FROM relay_requests WHERE launch=?").get(first.id);
+  const delivered = await relay.receive(next, file(input(next, "delivery", "b".repeat(40))), true, perform);
+  assert.equal(delivered.result.ok, true, "A new attempt's explicit delivery is a new request");
+  assert.equal(delivered.replayed, false); assert.equal(effects.length, 2);
+  assert.deepEqual(store.db.prepare("SELECT * FROM relay_requests WHERE launch=?").get(first.id), original);
+  const replay = await relay.receive(next, file(input(next, "delivery", "b".repeat(40)), "copy.json"), true, perform);
+  assert.equal(replay.replayed, true); assert.equal(effects.length, 2);
+  assert.deepEqual(replay.result, delivered.result);
+});
+await check("another_task_same_id_is_independent", async (relay, _store, effects, perform) => {
+  const other = { ...next, task: "other-task", fence: 1 };
+  await relay.receive(first, file(input(first)), true, perform);
+  assert.equal((await relay.receive(other, file(input(other)), true, perform)).result.ok, true);
+  assert.equal(effects.length, 2);
+});
+await check("same_launch_duplicate_change_and_pending_are_fenced", async (relay, _store, effects, perform) => {
+  const request = input(first);
+  const delivered = await relay.receive(first, file(request), true, perform);
+  const replay = await relay.receive(first, file(request, "copy.json"), true, perform);
+  assert.equal(replay.replayed, true); assert.deepEqual(replay.result, delivered.result); assert.equal(effects.length, 1);
+  const changed = file(input(first, "delivery", "c".repeat(40)));
+  assert.equal((await relay.receive(first, changed, true, perform)).result.error, "relay_request_id_reused");
+  assert.equal((await relay.receive(first, changed, true, perform)).replayed, true);
+  assert.equal(effects.length, 1);
+  let finish!: (value: any) => void;
+  const pending = input(first, "pending");
+  const running = relay.receive(first, file(pending), true, async (command: any) => {
+    effects.push(command); return new Promise((resolve) => { finish = resolve; });
+  });
+  assert.equal((await relay.receive(first, file(pending), true, perform)).result.error, "relay_outcome_unknown");
+  assert.equal(effects.length, 2); finish({ ok: true }); await running;
+});
+await check("legacy_result_and_pending_intent_remain_authoritative", async (relay, store, effects, perform) => {
+  const legacy = (id: string, result: any) => {
+    const request = input(first, id), key = "id:" + id;
+    const canonical = JSON.stringify(Object.fromEntries(Object.keys(request).sort().map((key) => [key, (request as any)[key]])));
+    store.db.prepare("INSERT INTO relay_requests(key,launch,task,attempt,request_id,input,created_at) VALUES (?,?,?,?,?,?,?)")
+      .run(key, first.id, first.task, first.attempt, id, canonical, "recorded-before-upgrade");
+    if (result) store.db.prepare("INSERT INTO relay_results(key,data,created_at) VALUES (?,?,?)")
+      .run(key, JSON.stringify(result), "recorded-before-upgrade");
+    return request;
+  };
+  const complete = legacy("old-complete", { ok: true, receipt: "original-result" });
+  const pending = legacy("old-pending", null);
+  assert.deepEqual((await relay.receive(first, file(complete), true, perform)).result, { ok: true, receipt: "original-result" });
+  assert.equal((await relay.receive(first, file(pending), true, perform)).result.error, "relay_outcome_unknown");
+  assert.equal(effects.length, 0, "Existing intents must not execute again after the key fix");
+  assert.equal(store.db.prepare("SELECT count(*) AS n FROM relay_requests").get().n, 2);
+});
+await check("foreign_payload_is_not_old_success", async (relay, _store, effects, perform) => {
+  await relay.receive(first, file(input(first)), true, perform);
+  const wrong = await relay.receive(next, file(input(first)), true, perform);
+  assert.equal(wrong.result.ok, false); assert.equal(effects.length, 1);
+});
+const report = { status: results.every((r) => r.pass) ? "PASS" : "INCOMPLETE", module: modulePath,
+  scope: "Controlled request boundary with counted effects; not provider or daemon evidence", argv: process.argv,
+  tests: results, real_codex_turns: 0 };
+writeFileSync(join(output, "run.json"), JSON.stringify(report, null, 2) + "\n", { flag: "wx" });
+console.log(JSON.stringify({ status: report.status, tests: results.map(({ name, pass, failure }) => ({ name, pass, failure })) }));
+process.exitCode = report.status === "PASS" ? 0 : 1;
diff --git a/workbench/tests/test_review_worktree_lifecycle_e2e.py b/workbench/tests/test_review_worktree_lifecycle_e2e.py
new file mode 100644
index 00000000..402b9235
--- /dev/null
+++ b/workbench/tests/test_review_worktree_lifecycle_e2e.py
@@ -0,0 +1,122 @@
+"""Review worktree names and cleanup through the real controlled gate entry.
+
+Independent expectations: spec section 4, T-077, controller #110. Only the
+external PTY/process/native facts and explicit reviewer decisions are supplied.
+Failure modes: leaked registered directory, reused ordinal, attached branch,
+cleanup before persisted result/reclaim, changed candidate binding, dirty/unknown
+scene deletion, or loss of the review result used by R8.
+"""
+import argparse
+import json
+from pathlib import Path
+
+from test_quality_chain_e2e import run_cases, save
+from test_quality_tracer_e2e import Tracer
+
+
+class ReviewWorktree(Tracer):
+    def registration(self, workspace):
+        result = self.process(['git', '-C', self.repo, 'worktree', 'list', '--porcelain', '-z'])
+        if result.returncode: raise RuntimeError('Cannot independently read Git worktree registry')
+        return 'worktree ' + workspace in result.stdout.split('\0'), result.stdout
+
+    def cleanup_after_persisted_result(self):
+        _, c = self.good_submission()
+        review, record = self.start_review(c)
+        attached = self.process(['git', '-C', review['workspace'], 'symbolic-ref', '--quiet', 'HEAD'])
+        self.check('REVIEW-DETACHED', attached.returncode == 1, 'detached reviewer checkout', attached.stdout)
+        self.check('REVIEW-CANDIDATE-HEAD', self.oid(Path(review['workspace'])) == c, c, self.oid(Path(review['workspace'])))
+        self.send_review(review, record, self.review_packet(review, c))
+        self.wait_review_reclaimed(review)
+        task = self.cli('status')['task']; events = self.events()
+        registered, raw = self.registration(review['workspace'])
+        exists = Path(review['workspace']).exists()
+        save(self.evidence / 'review-lifecycle-proof.json', {'review': review, 'task': task, 'events': events,
+             'directory_exists': exists, 'git_registered': registered, 'git_worktrees': raw})
+        self.check('REVIEW-DIRECTORY-REMOVED', not exists and not registered,
+                   {'directory_exists': False, 'git_registered': False}, {'directory_exists': exists, 'git_registered': registered})
+        relevant = [e for e in events if e['type'] in ('review_result', 'review_worktree_cleanup_intent',
+                    'review_worktree_removed', 'review_reclaimed') and
+                    (e['details'].get('review_id') or e['details'].get('review', {}).get('review_id')) == review['review_id']]
+        self.check('REVIEW-RESULT-BEFORE-REMOVE', [e['type'] for e in relevant] ==
+                   ['review_result', 'review_worktree_cleanup_intent', 'review_worktree_removed', 'review_reclaimed'],
+                   'stored result, confirmed stopped pane, cleanup intent/removal, then completed reclaim', relevant)
+        self.check('REVIEW-RESULT-UNCHANGED', task['review'] == next(e['details']['review'] for e in events if e['type'] == 'review_result'),
+                   'cleanup leaves the review object byte-equivalent to its durable result binding', task['review'])
+        self.integrate_scored(c, rounds=1)
+
+    def names_and_ordinals(self):
+        c2, second, _ = self.fix_after_review()
+        self.wait_review_reclaimed(second)
+        task = self.cli('status')['task']; events = self.events()
+        requested = [e['details']['review'] for e in events if e['type'] == 'review_requested']
+        expected = [str(self.state / 'worktrees' / task['project_id'] /
+                        (self.task + '-a1-review-' + str(i))) for i in (1, 2)]
+        save(self.evidence / 'review-names-proof.json', {'requested': requested, 'expected': expected, 'events': events})
+        self.check('REVIEW-S3-NAMES', len(requested) == 2 and [r['workspace'] for r in requested] == expected
+                   and [r.get('ordinal') for r in requested] == [1, 2]
+                   and len({r['review_id'] for r in requested}) == 2
+                   and requested[0]['candidate_commit'] != requested[1]['candidate_commit'],
+                   {'paths': expected, 'ordinals': [1, 2], 'fresh_candidates': True}, requested)
+        for item in requested:
+            registered, raw = self.registration(item['workspace'])
+            self.check('REVIEW-EACH-RESULT-CLEANED', not Path(item['workspace']).exists() and not registered,
+                       'both needs-fix and passed review directories are removed after their results', raw)
+        self.integrate_scored(c2, rounds=2, review_failures=1)
+
+    def dirty_review_is_preserved_and_reported(self):
+        _, c = self.good_submission()
+        review, record = self.start_review(c)
+        # A deliberate external actor change, outside the read-only reviewer.
+        path = Path(review['workspace']) / 'unexpected-external.txt'
+        content = b'Independent external content must survive.\n'
+        path.write_bytes(content)
+        self.send_review(review, record, self.review_packet(review, c))
+        events = self.wait_for(lambda: self.events(), lambda rows: any(
+            e['type'] in ('review_reclaimed', 'review_lifecycle_failed') for e in rows))
+        current = self.cli('status')['task']; registered, raw = self.registration(review['workspace'])
+        save(self.evidence / 'review-dirty-proof.json', {'review': review, 'task': current,
+             'events': events, 'git_worktrees': raw, 'file_bytes': list(path.read_bytes()) if path.exists() else None})
+        self.check('REVIEW-DIRTY-PRESERVED', current['state'] == 'paused' and current['review']['state'] == 'unknown'
+                   and registered and path.exists() and path.read_bytes() == content and self.oid() == self.base
+                   and any(e['type'] == 'issue_issue' for e in events)
+                   and not any(e['type'] == 'review_reclaimed' for e in events)
+                   and not any(e['type'] == 'review_worktree_removed' for e in events),
+                   'dirty reviewer scene is retained and reported; no successful reclaim or integration', current)
+
+    def changed_review_head_is_preserved_and_reported(self):
+        _, c = self.good_submission()
+        review, record = self.start_review(c)
+        # A clean but different detached HEAD is not the reviewed candidate.
+        self.git('commit', '--allow-empty', '-m', 'External unreviewed tip', cwd=review['workspace'])
+        other = self.oid(Path(review['workspace']))
+        self.send_review(review, record, self.review_packet(review, c))
+        events = self.wait_for(lambda: self.events(), lambda rows: any(
+            e['type'] in ('review_reclaimed', 'review_lifecycle_failed') for e in rows))
+        current = self.cli('status')['task']; registered, raw = self.registration(review['workspace'])
+        remains = Path(review['workspace']).exists()
+        actual = self.oid(Path(review['workspace'])) if remains else None
+        save(self.evidence / 'review-changed-head-proof.json', {'C': c, 'external': other, 'actual': actual,
+             'review': review, 'task': current, 'events': events, 'git_worktrees': raw})
+        self.check('REVIEW-UNKNOWN-HEAD-PRESERVED', other != c and current['state'] == 'paused'
+                   and current['review']['state'] == 'unknown' and registered and remains and actual == other
+                   and any(e['type'] == 'issue_issue' for e in events)
+                   and not any(e['type'] == 'review_worktree_removed' for e in events)
+                   and not any(e['type'] == 'review_reclaimed' for e in events) and self.oid() == self.base,
+                   'unknown clean HEAD is retained and reported without deleting or integrating it', current)
+
+
+CASES = ['cleanup_after_persisted_result', 'names_and_ordinals', 'dirty_review_is_preserved_and_reported',
+         'changed_review_head_is_preserved_and_reported']
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--case', choices=CASES, action='append')
+    args = parser.parse_args()
+    return run_cases(args.source, args.output, args.case or CASES, ReviewWorktree, dialect='current', stop_on_failure=True)
+
+
+if __name__ == '__main__': raise SystemExit(main())
diff --git a/workbench/tests/test_s3_quality_joint_e2e.py b/workbench/tests/test_s3_quality_joint_e2e.py
new file mode 100644
index 00000000..b745d82e
--- /dev/null
+++ b/workbench/tests/test_s3_quality_joint_e2e.py
@@ -0,0 +1,177 @@
+"""S3/T-076 joint contracts through real CLI, relay, Panes, gates and Git.
+
+Expected behavior is from T-077 Acceptance/R8 and spec sections 3, 4 and 8.
+Only PTY/process/native inputs and external worker/reviewer decisions are
+controlled. No gate result, state row or review verdict is inserted directly.
+"""
+import argparse
+import json
+from pathlib import Path
+import sys
+
+from test_quality_chain_e2e import run_cases, save
+from test_quality_tracer_e2e import Tracer
+
+
+class Joint(Tracer):
+    def external(self, files, message):
+        for name, content in files.items():
+            path = self.repo / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(content, encoding='utf-8')
+        self.git('add', *files)
+        self.git('commit', '-m', message)
+        return self.oid()
+
+    def integrate_current(self, candidate, head):
+        before = self.cli('status')['task']
+        expected = before['verification']['M']
+        reply = self.gate('integrate', '--attempt', self.a['attempt_id'], '--score-file', self.score_file())
+        self.check('JOINT-INTEGRATE', reply['ok'] and self.oid() == expected
+                   and reply['task']['state'] == 'accepted',
+                   {'state': 'accepted', 'main': expected}, reply)
+        for ancestor in (candidate, head):
+            result = self.process(['git', '-C', self.repo, 'merge-base', '--is-ancestor', ancestor, expected])
+            self.check('JOINT-ANCESTOR', result.returncode == 0, ancestor, result.returncode)
+        self.check('JOINT-SCORE-ONCE', len([e for e in self.events() if e['type'] == 'score_recorded']) == 1,
+                   'one score after real integration', self.events())
+
+    def same_candidate_reuses_review(self):
+        marker = self.root / 'independent-rule.jsonl'
+        self.write_rule_config('from pathlib import Path\nimport json,os\n'
+            'value=Path("host.txt").read_text()\n'
+            'assert value in ("base host\\n","external G\\n")\n'
+            'with open(' + repr(str(marker)) + ',"a") as out: out.write(json.dumps({"cwd":os.getcwd(),"host":value})+"\\n")')
+        a, c = self.good_submission()
+        review, _ = self.approve(c)
+        initial = self.cli('status')['task']['verification']
+        g = self.external({'host.txt': 'external G\n'}, 'Independent G after review of unchanged C')
+        reply = self.gate('integrate', '--attempt', a['attempt_id'], '--score-file', self.score_file())
+        current = self.cli('status')['task']
+        events = self.events()
+        requests = [e for e in events if e['type'] == 'review_requested']
+        results = [e for e in events if e['type'] == 'review_result']
+        reused = [e for e in events if e['type'] == 'review_reused']
+        v = current['verification']
+        self.check('JOINT-SAME-C-REUSE', reply['ok'] and current['state'] == 'accepted'
+                   and v['verification_id'] != initial['verification_id'] and v['G'] == g and v['C'] == c
+                   and len(requests) == len(results) == len(reused) == 1
+                   and current['review']['review_id'] == review['review_id']
+                   and reused[0]['details']['verification_id'] == v['verification_id'],
+                   'new G/M mechanical verification, same C and one valid independent review',
+                   {'reply': reply, 'task': current, 'requests': requests, 'results': results, 'reuse': reused})
+        ids = [initial['verification_id'], v['verification_id']]
+        for kind in ('path_check', 'completion_check', 'rule_check'):
+            self.check('JOINT-SAME-C-MECHANICAL-' + kind,
+                       [e['details']['verification_id'] for e in events if e['type'] == kind] == ids,
+                       ids, [e for e in events if e['type'] == kind])
+        self.check('JOINT-SAME-C-RULE-INPUTS',
+                   [json.loads(line)['host'] for line in marker.read_text().splitlines()] == ['base host\n', 'external G\n'],
+                   ['base host\n', 'external G\n'], marker.read_text())
+        self.check('JOINT-SAME-C-GIT', self.oid() == v['M']
+                   and (self.repo / 'host.txt').read_text() == 'external G\n', v['M'], self.oid())
+        save(self.evidence / 'joint-proof.json', {'task': current, 'events': events, 'C': c, 'G': g, 'main': self.oid()})
+
+    def changed_candidate_starts_fresh_review(self):
+        self.card['completion_conditions'] = [{'argv': [sys.executable, '-I', '-B', '-c',
+            'from pathlib import Path; expected="worker2\\n" if Path("host.txt").read_text()=="phase2\\n" else "worker\\n"; '
+            'assert Path("src/value.txt").read_text()==expected']}]
+        a, c1 = self.good_submission()
+        prior, record1 = self.approve(c1)
+        g = self.external({'host.txt': 'phase2\n'}, 'Independent G changes completion requirement')
+        refused = self.gate('integrate', '--attempt', a['attempt_id'], '--score-file', self.score_file())
+        self.check('JOINT-NEW-C-REJECTION', refused.get('error') == 'oracle_failed' and self.oid() == g,
+                   'new M fails its independent completion assertion and opens repair', refused)
+        self.wait_pane(lambda pane: pane['state'] == 'busy' and pane['turn'] == 'fixture-turn-3')
+        c2 = self.commit(a, {'src/value.txt': 'worker2\n'})
+        submitted = self.worker_submit(c2, request_id='delivery-2')
+        self.check('JOINT-NEW-C-SUBMIT', submitted['ok'], 'explicit new C from the bound repair turn', submitted)
+        reply = self.gate('verify', '--attempt', a['attempt_id'])
+        current = self.cli('status')['task']
+        review = current.get('review') or {}
+        self.check('JOINT-NEW-C-REVIEW', reply['ok'] and current['state'] == 'reviewing'
+                   and review.get('candidate_commit') == c2 and review.get('review_id') != prior['review_id']
+                   and review.get('session_id') != prior['session_id'] and review.get('launch_id') != prior['launch_id']
+                   and self.oid() == g,
+                   'C2 needs a new reviewer/session/launch before any integration', current)
+        other, record2 = self.approve(c2, automatic=True)
+        self.check('JOINT-NEW-C-NATIVE', record2['native'] != record1['native'], 'fresh reviewer native identity',
+                   {'first': record1['native'], 'next': record2['native']})
+        self.integrate_current(c2, g)
+        events = self.events()
+        self.check('JOINT-NEW-C-TWO-REVIEWS',
+                   [e['details']['review']['candidate_commit'] for e in events if e['type'] == 'review_result'] == [c1, c2]
+                   and not [e for e in events if e['type'] == 'review_reused'],
+                   'separate durable independent results for C1 and C2', events)
+        save(self.evidence / 'joint-proof.json', {'C1': c1, 'C2': c2, 'G': g, 'review': other,
+             'task': self.cli('status')['task'], 'events': events, 'main': self.oid()})
+
+    def conflict_then_quality_repair_submits_again(self):
+        self.card['goal'] = 'worker 与 host 设置都为 ready；保留 host-policy.txt'
+        self.card['completion_conditions'] = [{'argv': [sys.executable, '-I', '-B', '-c',
+            'import json; from pathlib import Path; '
+            'assert json.loads(Path("src/settings.json").read_text())=={"worker":"ready","host":"ready"}; '
+            'assert Path("host-policy.txt").read_text()=="host policy\\n"']}]
+        self.base = self.external({'src/settings.json': '{"worker":"base","host":"base"}\n',
+                                  'host-policy.txt': 'baseline\n'}, 'Independent joint conflict baseline')
+        a = self.start_worker()
+        c1 = self.commit(a, {'src/settings.json': '{"worker":"ready","host":"base"}\n'})
+        first = self.worker_submit(c1)
+        self.check('JOINT-CONFLICT-C1', first['ok'], 'C1 explicitly submitted', first)
+        g = self.external({'src/settings.json': '{"worker":"base","host":"ready"}\n',
+                           'host-policy.txt': 'host policy\n'}, 'Independent same-line host conflict')
+        conflict = self.gate('verify', '--attempt', a['attempt_id'])
+        self.check('JOINT-CONFLICT-WRITEBACK', conflict.get('error') == 'merge_conflict'
+                   and self.cli('status')['task']['state'] == 'rework' and self.oid() == g,
+                   'real same-line conflict opens worker rework without integrating', conflict)
+        self.wait_pane(lambda pane: pane['state'] == 'busy' and pane['turn'] == 'fixture-turn-3')
+        # This is the external worker actor in its own temporary worktree.
+        # The product gate does not reset or choose conflict content.
+        self.git('reset', '--hard', g, cwd=a['workspace'])
+        c2 = self.commit(a, {'src/settings.json': '{"worker":"almost","host":"ready"}\n'})
+        second = self.worker_submit(c2, request_id='delivery-2')
+        self.check('JOINT-CONFLICT-C2', second['ok'], 'conflict rework C2 explicitly submitted', second)
+        rejected = self.gate('verify', '--attempt', a['attempt_id'])
+        self.check('JOINT-CONFLICT-QUALITY', rejected.get('error') == 'oracle_failed' and self.oid() == g,
+                   'C2 is rejected by the independent completion condition', rejected)
+        self.wait_pane(lambda pane: pane['state'] == 'busy' and pane['turn'] == 'fixture-turn-5')
+        c3 = self.commit(a, {'src/settings.json': '{"worker":"ready","host":"ready"}\n'})
+        third = self.worker_submit(c3, request_id='delivery-3')
+        self.check('JOINT-CONFLICT-QUALITY-SUBMIT', third['ok'] and third['task']['candidate_commit'] == c3,
+                   'same bound rework attempt may explicitly deliver C3 after quality rejection', third)
+        verified = self.gate('verify', '--attempt', a['attempt_id'])
+        self.check('JOINT-CONFLICT-C3-REVIEW', verified['ok'] and verified['task']['state'] == 'reviewing'
+                   and verified['task']['review']['candidate_commit'] == c3,
+                   'C3 repeats all mechanical gates and starts independent review', verified)
+        self.approve(c3, automatic=True)
+        self.integrate_current(c3, g)
+        task = self.cli('status')['task']; events = self.events()
+        checks = [e for e in events if e['type'] == 'completion_check']
+        self.check('JOINT-CONFLICT-FULL-CHAIN', len(checks) == 2
+                   and [e['details']['passed'] for e in checks] == [False, True]
+                   and len([e for e in events if e['type'] == 'path_check']) == 2
+                   and len([e for e in events if e['type'] == 'review_result']) == 1
+                   and task['current_attempt']['attempt_id'] == a['attempt_id']
+                   and task['current_attempt']['rework']['candidate_commit'] == c3
+                   and task['current_attempt']['rework']['base_commit'] == g,
+                   'same attempt, immutable recorded G, failed C2 then passed/reviewed/integrated C3',
+                   {'task': task, 'events': events})
+        save(self.evidence / 'joint-proof.json', {'C1': c1, 'C2': c2, 'C3': c3, 'G': g,
+             'task': task, 'events': events, 'main': self.oid()})
+
+
+CASES = ['same_candidate_reuses_review', 'changed_candidate_starts_fresh_review',
+         'conflict_then_quality_repair_submits_again']
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--case', choices=CASES, action='append')
+    args = parser.parse_args()
+    return run_cases(args.source, args.output, args.case or CASES, Joint, dialect='current', stop_on_failure=True)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/workbench/tests/test_task_cards_e2e.py b/workbench/tests/test_task_cards_e2e.py
index 210b2b97..c6f61ed0 100644
