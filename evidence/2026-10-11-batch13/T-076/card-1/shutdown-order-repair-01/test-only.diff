+net.createServer = (...args: any[]) => {
+  const server = Reflect.apply(originalCreateServer, net, args);
+  server.on("connection", (socket: any) => {
+    let input = "", inspected = false;
+    socket.on("data", (chunk: any) => {
+      if (inspected) return;
+      input += String(chunk);
+      const end = input.indexOf("\n");
+      if (end < 0) return;
+      inspected = true;
+      const envelope = JSON.parse(input.slice(0, end));
+      if (envelope.input?.command !== "daemon_stop") return;
+      socket.once("close", () => setImmediate(() => {
+        appendFileSync(join(control, "stop-response-closed.jsonl"), JSON.stringify({
+          request: envelope.id, pid: process.pid, phase: "after-stop-socket-close-callbacks",
+        }) + "\n");
+      }));
+    });
+  });
+  return server;
+};
