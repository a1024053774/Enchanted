diff --git a/workbench/README.md b/workbench/README.md
index a1b83763..c829891a 100644
--- a/workbench/README.md
+++ b/workbench/README.md
@@ -143,7 +143,17 @@ worker。已有 pane_exit 可证明停止时执行显示“已中断”；没有
 新增 launch_records、dispatch_records、orchestration_events、relay_requests、relay_results
 都在 state.sqlite3，触发器禁止
 UPDATE/DELETE。按 T-075 rev 3，原门禁状态表保留为由事件推出的当前视图，历史以事件为准；
-membership.sqlite3 和锁库保留。事件重建与视图一致性验证留给后续切片，本卡不迁移存储。
+membership.sqlite3 和锁库保留。`stateConsistency.ts` 提供只读事件重建与逐表比较；
+不补事件、改表或修存储。对静止的夹具库运行，报告一致、不一致或无法从现有事件重建：
+
+```sh
+node workbench/src/stateConsistency.ts --state /绝对路径/state --output /绝对路径/新报告.json
+```
+
+报告包含 tasks、历史 attempts/verifications、runs、attachments 与另库的 memberships/
+session_presets，列出差异、缺历史来源和未覆盖表。attachment creating 缺事件、active 行与
+attached 事件不同事务，以及成员/预设另库覆盖写都不能用最终行相等掩盖；诊断不一致或
+不可重建返回 INCOMPLETE。两库分别有读事务，不宣称跨库同事务。
 
 受管 worker 仍使用同一 CLI 显式 `submit`；`status`、`issue` 也走同一条转交路径。
 CLI 将带 task、attempt、session、fence、spec_rev 的请求写入 `A2A_REQUEST_DIR`，返回
@@ -156,9 +166,19 @@ CLI 将带 task、attempt、session、fence、spec_rev 的请求写入 `A2A_REQU
 处理结果未知时保留意图，不自动重试。一次 Stop 的新结果合成一条 `⟦门禁 #序号⟧`
 回执，先登记，再在空闲窗格里 bracketed paste 并单独回车。回执会启动新的原生回合，
 计入启动记录里的回合上限；本卡已获准一个交付回合和一个只确认回执的回合。
-Git 尾注钩子当前只读会话环境；最近回合模型与强度取不到时写 unknown，不把启动请求当实际值。
-本卡真实候选的这两项均为 unknown；原生记录另有实际回合模型与强度。后续需把已核对的
-回合事实传给钩子；只预填启动记录的请求参数时，仍须标明其来源，不能冒充最近回合观测。
+Git 尾注钩子从隔离 CODEX_HOME 中读取 CODEX_THREAD_ID 绑定的唯一根 CLI JSONL，
+以最新 task_started 对应的 turn_context 取实际模型与强度；辅助会话不提供取值。
+当前回合缺上下文时写 unknown，不沿用上一回合或请求值。启动请求另存
+A2A_MODEL_REQUESTED/A2A_EFFORT_REQUESTED；实际沙箱读取与提交时序还须通过真实回合验收。
+
+运行时 agent 身份与交付回合分开：attempt 绑定 launch/thread、shell、原生会话和 Codex 领导者；
+run/reclaim 核对该身份，回执回合改变不会覆盖已提交的 turn_id。submit 仍要求当前活动
+caller/turn 和受管 session/fence/spec/attempt 一致。换领导者、换原生会话或缺已绑定事实
+拒收；停止后只沿用已核对的身份及确认的生命周期，不按新 PID 接管。
+
+`run_daemon_acceptance.py --suite <coop|recovery|run> --output-root /绝对路径/证据根 --label 新标签`
+可把本轮三套验收写到独立证据目录；默认输出根沿用原 T-075/card-5。旧 validation 模式
+包含冻结的基线运行器，保留原输出根；新切片使用 suite/probe，不混写旧证据。
 
 ## 来源与改动
 
diff --git a/workbench/hooks/hook.py b/workbench/hooks/hook.py
index cd650e49..7243b45f 100755
--- a/workbench/hooks/hook.py
+++ b/workbench/hooks/hook.py
@@ -1,22 +1,64 @@
 #!/usr/bin/env python3
-"""Add session environment facts. The delivery channel is pending decision 02."""
+"""Add managed identity and the latest root native turn's observed facts."""
+import json
 import os
 from pathlib import Path
 import subprocess
 import sys
 
 
+def latest_turn_facts(env):
+    home, native = env.get('CODEX_HOME'), env['CODEX_THREAD_ID']
+    if not home:
+        return 'unknown', 'unknown'
+    sessions = Path(home).resolve() / 'sessions'
+    files = [path for path in sessions.rglob('*.jsonl') if path.name.endswith(native + '.jsonl')]
+    if not files:
+        return 'unknown', 'unknown'
+    if len(files) != 1 or sessions not in files[0].resolve().parents:
+        raise ValueError('原生会话记录不唯一或路径越界')
+    turn, context, bound = None, None, False
+    with files[0].open('r', encoding='utf-8') as stream:
+        for line in stream:
+            if not line.endswith('\n'):
+                break  # An incomplete append cannot provide current-turn facts.
+            record = json.loads(line)
+            if not isinstance(record, dict):
+                raise ValueError('原生记录不是 JSON 对象')
+            payload = record.get('payload', {})
+            if record.get('type') in ('session_meta', 'event_msg', 'turn_context') and not isinstance(payload, dict):
+                raise ValueError('原生身份或回合记录的 payload 不合法')
+            if record.get('type') == 'session_meta':
+                if payload.get('id') != native or payload.get('source') != 'cli':
+                    raise ValueError('原生记录不是本根 CLI 会话')
+                bound = True
+            elif record.get('type') == 'event_msg' and payload.get('type') == 'task_started':
+                turn, context = payload.get('turn_id'), None
+            elif record.get('type') == 'turn_context' and turn and payload.get('turn_id') == turn:
+                context = payload
+    if not bound:
+        raise ValueError('原生记录缺少根会话身份')
+    if context is None:
+        return 'unknown', 'unknown'
+    return context.get('model') or 'unknown', context.get('effort') or context.get('reasoning_effort') or 'unknown'
+
+
 def add_trailers():
     env = os.environ
     trailers = {'A2A-Task': env['A2A_TASK'], 'A2A-Attempt': env['A2A_ATTEMPT'],
                 'A2A-Session': env['A2A_SESSION'], 'A2A-Role': env['A2A_ROLE'],
-                'A2A-Tool': env['A2A_TOOL'], 'A2A-Model': env.get('A2A_MODEL', 'unknown'),
-                'A2A-Effort': env.get('A2A_EFFORT', 'unknown'), 'A2A-Native-Session': env['CODEX_THREAD_ID'],
+                'A2A-Tool': env['A2A_TOOL'], 'A2A-Model': 'unknown',
+                'A2A-Effort': 'unknown', 'A2A-Native-Session': env['CODEX_THREAD_ID'],
                 'A2A-Launch': env['A2A_LAUNCH']}
     # Validate before any edit. Requested launch settings are not observed turn facts.
     for key, content in trailers.items():
-        if not content or '\n' in content or '\r' in content:
+        if not isinstance(content, str) or not content or '\n' in content or '\r' in content:
             raise ValueError('尾注值不合法：' + key)
+    trailers['A2A-Model'], trailers['A2A-Effort'] = latest_turn_facts(env)
+    for key in ('A2A-Model', 'A2A-Effort'):
+        value = trailers[key]
+        if not isinstance(value, str) or not value or '\n' in value or '\r' in value:
+            raise ValueError('原生回合尾注值不合法：' + key)
     message = sys.argv[1]
     parsed = subprocess.check_output(['git', 'interpret-trailers', '--parse', '--no-divider', message], text=True)
     counts = {key.lower(): 0 for key in trailers}
