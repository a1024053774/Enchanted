{"schema": 1, "probe": "T076-2-P-review-02", "cwd": "/private/tmp/a2a-t076-p-review-02/host-control", "contract": "clamp(value) accepts only int, not bool; other types raise ValueError(\"not_int\"). Return 0 below 0, 100 above 100, and value otherwise.\n", "candidate_source": "def clamp(value):\n    if type(value) is not int:\n        raise ValueError(\"not_int\")\n    return max(0, min(100, value))\n", "sentinel_before": "T076-P-review immutable sentinel\n", "write_attempts": 1, "denied": false, "errno": null}
