it、status、issue 请求写到 A2A_REQUEST_DIR 指向的本 attempt 专用 /tmp 目录；不直接连接 socket。queued=true 只表示已排队，不是门禁通过。最后结束回合，让 Stop hook 读取并转交；没有请求文件就不交付。请求文件不得进入 Git 提交。查状态用同一入口 status --task，问题上报用 issue --task --title --body。不要修改合同、验收程序或沙箱权限。"}},{"seq":19,"time":"2026-10-11T17:20:56.938Z","task":"fixture-20261011-1","attempt":"2f7f7118-48f2-4213-ac17-45ab354356a9","type":"dispatched","details":{"attempt":{"task_id":"fixture-20261011-1","attempt_id":"2f7f7118-48f2-4213-ac17-45ab354356a9","session_id":"a2ea99f1-ced1-41be-83d7-e27a3ab97777","fence":1,"spec_rev":1,"thread_id":"673e3d70-3f42-4a80-9951-be89946df9fd","runtime_mode":"workspace-write","turn_id":null,"runtime_identity":{"launch":"fba128a7-2494-4b43-a89c-fa972562a4bc","thread":"673e3d70-3f42-4a80-9951-be89946df9fd","shell_pid":31000,"leader_pid":31001,"native_session":"fixture-native-fba128a7-2494-4b43-a89c-fa972562a4bc"},"workspace":"/private/tmp/q76-zgt9gxw0/c-ynp4553w/state/worktrees/2f7f7118-48f2-4213-ac17-45ab354356a9","base_commit":"1669ff16717ee9f4506dfe4016306f50f3323c34","card_snapshot_id":"77706661-c1aa-481f-af62-13a9a7fe48fb","reclaimed":false,"owner":"fixture-20261011-1","state":"claimed"}}},{"seq":20,"time":"2026-10-11T17:20:58.161Z","task":"fixture-20261011-1","attempt":"2f7f7118-48f2-4213-ac17-45ab354356a9","type":"command_intent","details":{"argv":["git","-C","/private/tmp/q76-zgt9gxw0/c-ynp4553w/repo","cat-file","-t","029b4e6663ee68942bf74458988a993e62735dce"],"cwd":"/private/tmp/q76-zgt9gxw0/c-ynp4553w/repo"}},{"seq":21,"time":"2026-10-11T17:20:58.167Z","task":"fixture-20261011-1","attempt":"2f7f7118-48f2-4213-ac17-45ab354356a9","type":"command_result","details":{"argv":["git","-C","/private/tmp/q76-zgt9gxw0/c-ynp4553w/repo","cat-file","-t","029b4e6663ee68942bf74458988a993e62735dce"],"cwd":"/private/tmp/q76-zgt9gxw0/c-ynp4553w/repo","stdout":"commit\n","stderr":"","exit":0,"returncode":0}},{"seq":22,"time":"2026-10-11T17:20:58.167Z","task":"fixture-20261011-1","attempt":"2f7f7118-48f2-4213-ac17-45ab354356a9"