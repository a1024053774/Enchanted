submit、status、issue 请求写到 A2A_REQUEST_DIR 指向的本 attempt 专用 /tmp 目录；不直接连接 socket。queued=true 只表示已排队，不是门禁通过。最后结束回合，让 Stop hook 读取并转交；没有请求文件就不交付。请求文件不得进入 Git 提交。查状态用同一入口 status --task，问题上报用 issue --task --title --body。不要修改合同、验收程序或沙箱权限。"}},{"seq":19,"time":"2026-10-11T17:20:52.047Z","task":"fixture-20261011-1","attempt":"2a0c44eb-c42c-4032-b974-c599bafda708","type":"dispatched","details":{"attempt":{"task_id":"fixture-20261011-1","attempt_id":"2a0c44eb-c42c-4032-b974-c599bafda708","session_id":"ebf6f2ec-0fb6-4075-bf5f-0b9c53b1517e","fence":1,"spec_rev":1,"thread_id":"83fbd44c-9464-405d-b4cd-2ea0d509c261","runtime_mode":"workspace-write","turn_id":null,"runtime_identity":{"launch":"55c3a7c2-b213-49dd-96da-d8cf584a4c60","thread":"83fbd44c-9464-405d-b4cd-2ea0d509c261","shell_pid":31000,"leader_pid":31001,"native_session":"fixture-native-55c3a7c2-b213-49dd-96da-d8cf584a4c60"},"workspace":"/private/tmp/q76-8es8fjzc/c-7q9kw_el/state/worktrees/2a0c44eb-c42c-4032-b974-c599bafda708","base_commit":"105477a2c08e8ccec3b9a3d6ed46dc1397e67b6e","card_snapshot_id":"8851e01b-6589-4a4c-90e6-127c3f9c32f0","reclaimed":false,"owner":"fixture-20261011-1","state":"claimed"}}},{"seq":20,"time":"2026-10-11T17:20:53.253Z","task":"fixture-20261011-1","attempt":"2a0c44eb-c42c-4032-b974-c599bafda708","type":"command_intent","details":{"argv":["git","-C","/private/tmp/q76-8es8fjzc/c-7q9kw_el/repo","cat-file","-t","182e68e9cb61ec4cd5e03f0099209d9482f75917"],"cwd":"/private/tmp/q76-8es8fjzc/c-7q9kw_el/repo"}},{"seq":21,"time":"2026-10-11T17:20:53.259Z","task":"fixture-20261011-1","attempt":"2a0c44eb-c42c-4032-b974-c599bafda708","type":"command_result","details":{"argv":["git","-C","/private/tmp/q76-8es8fjzc/c-7q9kw_el/repo","cat-file","-t","182e68e9cb61ec4cd5e03f0099209d9482f75917"],"cwd":"/private/tmp/q76-8es8fjzc/c-7q9kw_el/repo","stdout":"commit\n","stderr":"","exit":0,"returncode":0}},{"seq":22,"time":"2026-10-11T17:20:53.259Z","task":"fixture-20261011-1","attempt":"2a0c44eb-c42c-4032-b974-c599bafda