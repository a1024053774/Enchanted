+  it("accepts request-bound WS answers while retaining message and attempt identity checks", () => {
+    const answer = {
+      ...worker,
+      details: {
+        ...worker.details,
+        form: "answer",
+        channel: "ws-rpc",
+        message_id: null,
+        request_id: "external-request-A",
