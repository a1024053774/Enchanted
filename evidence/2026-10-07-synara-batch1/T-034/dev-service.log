DESCRIPTION
  Run monorepo development modes with deterministic port/env wiring.

USAGE
  dev-runner [flags] <mode> <turbo-arg...>

ARGUMENTS
  mode choice            Development mode to run.
  turbo-arg... string    Additional turbo args (pass after `--`).

FLAGS
  --home-dir string             Base directory for all Synara data (equivalent to SYNARA_HOME).
  --auth-token, --token string  Auth token (forwards to SYNARA_AUTH_TOKEN).
  --no-browser                  Disable browser auto-open (equivalent to SYNARA_NO_BROWSER).
  --browser                     Enable browser auto-open.
  --auto-bootstrap-project-from-cwdEnable project auto-bootstrap (equivalent to SYNARA_AUTO_BOOTSTRAP_PROJECT_FROM_CWD).
  --no-auto-bootstrap-project-from-cwdDisable: Enable project auto-bootstrap (equivalent to SYNARA_AUTO_BOOTSTRAP_PROJECT_FROM_CWD).
  --log-websocket-events, --log-ws-eventsEnable WebSocket event logging (equivalent to SYNARA_LOG_WS_EVENTS).
  --no-log-websocket-events     Disable: Enable WebSocket event logging (equivalent to SYNARA_LOG_WS_EVENTS).
  --host string                 Server host/interface override (forwards to SYNARA_HOST).
  --port integer                Server port override (forwards to SYNARA_PORT).
  --dev-url string              Web dev URL override (forwards to VITE_DEV_SERVER_URL).
  --dry-run                     Resolve mode/ports/env and print, but do not spawn turbo.

GLOBAL FLAGS
  --help, -h              Show help information
  --version               Show version information
  --completions choice    Print shell completion script
  --log-level choice      Sets the minimum log level

